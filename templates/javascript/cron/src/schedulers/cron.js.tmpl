import { Cron } from "croner";
import { config } from "../config/config.js";
import { randomUUID } from "node:crypto";
import { logger } from "../config/logger.js";
import { redis } from "../config/redis.js";
import * as sampleReportJob from "../jobs/sampleReportJob.js";
import { withLock } from "../utils/lock.js";

// Register every job here, explicitly.
export const schedule = [
  { job: sampleReportJob, pattern: "0 */5 * * * *", lockTtlMs: 5 * 60_000 },
];

export const getAvailableJobs = () => schedule.map((e) => e.job.JOB_NAME);

export const findJob = (name) => schedule.find((e) => e.job.JOB_NAME === name);

// execute runs one job under its distributed lock, with a run-scoped logger and timing.
// Errors are logged and rethrown (the scheduler swallows them; the CLI exits 1).
export async function execute(entry) {
  const runId = randomUUID();
  const log = logger.child({ job: entry.job.JOB_NAME, run_id: runId });
  const start = performance.now();
  try {
    const res = await withLock(
      redis,
      entry.job.JOB_NAME,
      runId,
      entry.lockTtlMs,
      () => entry.job.run(log),
    );
    const duration_ms = Math.round(performance.now() - start);
    if (!res.ran) {
      log.info(
        { action: "skipped_locked" },
        "already running on another instance",
      );
      return undefined;
    }
    log.info({ action: "done", duration_ms }, "job finished");
    return res.result;
  } catch (err) {
    log.error({ action: "failed", err }, "job failed");
    throw err;
  }
}

// Runs in progress, so shutdown can wait for them before closing the DB and Redis.
const running = new Set();

// startScheduler registers every entry. An invalid pattern throws here, at startup.
// protect: a slow run is never overlapped by its next tick on the same instance.
export function startScheduler() {
  return schedule.map(
    (entry) =>
      new Cron(
        entry.pattern,
        {
          name: entry.job.JOB_NAME,
          timezone: config.CRON_TIMEZONE,
          protect: true,
          catch: () => {}, // already logged by execute
        },
        async () => {
          const run = execute(entry);
          running.add(run);
          try {
            await run;
          } finally {
            running.delete(run);
          }
        },
      ),
  );
}

// stopScheduler stops new ticks and waits for the runs in progress (their errors are logged).
export async function stopScheduler(crons) {
  for (const c of crons) c.stop();
  await Promise.allSettled(running);
  logger.info({ jobs: crons.length }, "scheduler stopped");
}
