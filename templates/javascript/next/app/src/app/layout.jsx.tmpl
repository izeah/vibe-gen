import { cookies } from "next/headers";
import { ThemeToggle } from "../components/atoms/ThemeToggle.jsx";
import { themeFrom } from "../lib/theme.js";
import "../styles/globals.css";
import { Providers } from "./providers.jsx";

export const metadata = { title: "{{.ProjectTitle}}" };

// Every page is rendered per request so Next can apply the CSP nonce from src/proxy.
export const dynamic = "force-dynamic";

export default async function RootLayout({ children }) {
  // The cookie is allowlisted to light|dark before it becomes an attribute; none = follow the OS.
  const theme = themeFrom((await cookies()).get("theme")?.value);
  return (
    <html lang="en" data-theme={theme}>
      <body>
        <ThemeToggle />
        <Providers>{children}</Providers>
      </body>
    </html>
  );
}
