import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import NextApp from "next/app";
import Head from "next/head";
import { useState } from "react";
import { ThemeToggle } from "../components/atoms/ThemeToggle.jsx";
import "../styles/globals.css";

export default function App({ Component, pageProps }) {
  const [client] = useState(() => new QueryClient());
  return (
    <QueryClientProvider client={client}>
      <Head>
        <title>{{.ProjectTitle}}</title>
      </Head>
      <ThemeToggle />
      <Component {...pageProps} />
    </QueryClientProvider>
  );
}

// Render every page per request: a statically optimized page has no request, so it could not
// carry the CSP nonce from src/proxy and the browser would block its scripts.
App.getInitialProps = (ctx) => NextApp.getInitialProps(ctx);
