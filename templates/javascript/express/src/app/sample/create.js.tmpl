import { created } from "../../abstraction/response.js";
import { parse } from "../../abstraction/validate.js";
import { sampleCreateRequest } from "../../dto/sample.js";
import { ctxOf } from "../../middleware/context.js";

// POST /v1/samples
export const create = (h) => async (req, res) => {
  const body = parse(sampleCreateRequest, req.body);
  res.status(201).json(created(await h.sampleService.create(ctxOf(res), body)));
};
