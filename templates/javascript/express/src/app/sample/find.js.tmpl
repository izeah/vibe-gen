import { success } from "../../abstraction/response.js";
import { parse } from "../../abstraction/validate.js";
import { sampleFindQuery } from "../../dto/sample.js";
import { ctxOf } from "../../middleware/context.js";

// GET /v1/samples?page=&page_size=&sort_by=&sort=&name=&status=
export const find = (h) => async (req, res) => {
  const query = parse(sampleFindQuery, req.query);
  const { data, info } = await h.sampleService.find(ctxOf(res), query);
  res.json(success(data, info));
};
