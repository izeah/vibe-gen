import { clear, guard, refreshTokenOf } from "../../abstraction/auth-cookie.js";
import { success } from "../../abstraction/response.js";
import { ctxOf } from "../../middleware/context.js";
import { cookieIO } from "../../middleware/cookie-io.js";

// POST /v1/auth/logout
export const logout = (h) => async (req, res) => {
  const io = cookieIO(req, res);
  guard(h.config, io);
  clear(h.config, io); // always drop the cookie, even if the token is invalid
  const body = await refreshTokenOf(h.config, io, async () => req.body);
  await h.authService.logout(ctxOf(res), body);
  res.json(success());
};
