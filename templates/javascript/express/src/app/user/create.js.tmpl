import { created } from "../../abstraction/response.js";
import { parse } from "../../abstraction/validate.js";
import { userCreateRequest } from "../../dto/user.js";
import { ctxOf } from "../../middleware/context.js";

// POST /v1/users (admin)
export const create = (h) => async (req, res) => {
  const body = parse(userCreateRequest, req.body);
  res.status(201).json(created(await h.userService.create(ctxOf(res), body)));
};
