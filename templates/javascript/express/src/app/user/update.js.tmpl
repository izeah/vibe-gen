import { success } from "../../abstraction/response.js";
import { parse } from "../../abstraction/validate.js";
import { userIdParams, userUpdateRequest } from "../../dto/user.js";
import { ctxOf } from "../../middleware/context.js";

// PUT /v1/users/:id (admin)
export const update = (h) => async (req, res) => {
  const { id } = parse(userIdParams, req.params);
  const body = parse(userUpdateRequest, req.body);
  res.json(success(await h.userService.update(ctxOf(res), id, body)));
};
