<script setup>
import { onMounted, ref } from "vue";
import { currentTheme, setTheme } from "../../../src/lib/theme-client.js";

// One labelled button; the state lives in aria-pressed. The server cannot know the OS preference,
// so the state is read after mount (the colors never wait: data-theme/CSS decide them).
const dark = ref(false);
onMounted(() => {
  dark.value = currentTheme() === "dark";
});

function toggle() {
  const next = dark.value ? "light" : "dark";
  setTheme(next);
  dark.value = next === "dark";
}
</script>

<template>
  <button type="button" class="theme-toggle" :aria-pressed="dark" @click="toggle">Dark mode</button>
</template>
