import bcrypt from "bcryptjs";
import { z } from "zod";

// Same cost as Go's bcrypt.DefaultCost, so hashes are interchangeable with the Go templates.
const COST = 10;

// bcrypt ignores everything past 72 BYTES; z.max(72) counts UTF-16 units, so check bytes.
export const passwordSchema = z
  .string()
  .min(8)
  .refine((s) => Buffer.byteLength(s) <= 72, "must be at most 72 bytes");

// Callers hash explicitly; never guess whether a value is already a hash (a hash-shaped
// password would be stored as is).
export const hashPassword = (plain) => bcrypt.hash(plain, COST);

export const comparePassword = (plain, hash) => bcrypt.compare(plain, hash);

// Comparing against this hash when the email is unknown makes that path as slow as a
// wrong password, so response timing does not reveal which emails are registered.
let dummy;
export const dummyHash = () => {
  dummy ??= hashPassword("timing-equalizer-not-a-password");
  return dummy;
};
