import { and, eq, ilike, inArray, isNull } from "drizzle-orm";
import { z } from "zod";
import { DEFAULT_SYSTEM_USER_ID, toRFC3339 } from "../abstraction/entity.js";
import { escapeLike, paginationQuery } from "../abstraction/pagination.js";
import { samples } from "../model/sample.js";

// sampleSortColumns is the ORDER BY allowlist for SampleFilter (API field → column).
export const sampleSortColumns = {
  id: samples.id,
  name: samples.name,
  status: samples.status,
  created_at: samples.createdAt,
  updated_at: samples.updatedAt,
};

export function sampleWhere(f) {
  return and(
    f.withDeleted ? undefined : isNull(samples.deletedAt),
    f.ids ? inArray(samples.id, f.ids) : undefined,
    f.name ? ilike(samples.name, `%${escapeLike(f.name)}%`) : undefined,
    f.status ? eq(samples.status, f.status) : undefined,
    f.createdBy ? eq(samples.createdBy, f.createdBy) : undefined,
    ...(f.where ?? []),
  );
}

// GET /samples query: pagination + filters.
export const sampleFindQuery = paginationQuery.extend({
  name: z.string().max(100).optional(),
  status: z.string().max(20).optional(),
});

export const sampleIdParams = z.object({ id: z.uuid() });

export const sampleCreateRequest = z.object({
  name: z.string().trim().min(1).max(100),
  description: z.string().max(500).default(""),
});

export const sampleUpdateRequest = z.object({
  name: z.string().trim().min(1).max(100).optional(),
  description: z.string().max(500).optional(),
});

export const toSampleResponse = (m) => ({
  id: m.id,
  name: m.name,
  description: m.description,
  status: m.status,
  created_at: toRFC3339(m.createdAt),
  updated_at: m.updatedAt === null ? undefined : toRFC3339(m.updatedAt),
  created_by: m.createdBy === DEFAULT_SYSTEM_USER_ID ? undefined : m.createdBy,
  updated_by: m.updatedBy ?? undefined,
});
