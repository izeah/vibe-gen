const schema = (s) => {
  const { $schema: _, ...rest } = z.toJSONSchema(s, { io: "input" });
  return rest;
};

const parameters = (s, where) => {
  if (!s) return [];
  const js = schema(s);
  return Object.entries(js.properties ?? {}).map(([name, prop]) => ({
    name,
    in: where,
    required: where === "path" || (js.required ?? []).includes(name),
    schema: prop,
  }));
};

const envelope = (success) => ({
  "application/json": {
    schema: {
      type: "object",
      properties: {
        meta: {
          type: "object",
          properties: {
            success: { const: success },
            message: { type: "string" },
            ...(success && { info: { type: "object" } }),
          },
        },
        data: {},
        ...(!success && { description: { type: "object" } }),
      },
    },
  },
});

export function openapiDocument(cfg) {
  const paths = {};
  for (const op of operations) {
    const responses = {
      [op.status ?? 200]: { description: "OK", content: envelope(true) },
      400: { description: "Invalid input", content: envelope(false) },
    };
    if (op.auth)
      responses[401] = {
        description: "Missing or invalid access token",
        content: envelope(false),
      };
    if (op.permission) {
      responses[403] = {
        description: `Role lacks ${op.permission} (any or own scope)`,
        content: envelope(false),
      };
    }
    const path = paths[op.path] ?? {};
    paths[op.path] = path;
    path[op.method] = {
      tags: [op.tag],
      summary: op.summary,
      ...(op.permission && {
        description: `Requires permission \`${op.permission}\`.`,
      }),
      ...(op.auth && { security: [{ bearerAuth: [] }] }),
      parameters: [
        ...parameters(op.params, "path"),
        ...parameters(op.query, "query"),
      ],
      ...(op.body &&
        !(op.cookieAuth && cfg.AUTH_COOKIE_MODE) && {
          requestBody: {
            required: true,
            content: { "application/json": { schema: schema(op.body) } },
          },
        }),
      responses,
    };
  }
  return {
    openapi: "3.1.0",
    info: { title: `${cfg.APP_NAME} API`, version: "v1" },
    servers: [{ url: cfg.APP_BASE_PATH || "/" }],
    components: {
      securitySchemes: {
        bearerAuth: { type: "http", scheme: "bearer", bearerFormat: "JWT" },
      },
    },
    paths,
  };
}
