import { conn } from "../../abstraction/context.js";
import { roleWhere } from "../../dto/role.js";
import { roles } from "../../model/role.js";

// deleteRows hard-deletes the matching rows (soft-deleted rows only with withDeleted: true).
// Prefer softDelete; never expose this through an endpoint unless a feature needs it.
export async function deleteRows(ctx, f) {
  const res = await conn(ctx).delete(roles).where(roleWhere(f));
  return res.rowCount ?? 0;
}
