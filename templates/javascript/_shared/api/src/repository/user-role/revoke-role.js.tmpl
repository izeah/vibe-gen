import { and, eq, inArray } from "drizzle-orm";
import { conn } from "../../abstraction/context.js";
import { userRoles } from "../../model/user-role.js";

// revokeRole takes the roles away from the user (hard delete); returns the number removed.
export async function revokeRole(ctx, userId, ...roleIds) {
  if (roleIds.length === 0) return 0;
  const res = await conn(ctx)
    .delete(userRoles)
    .where(
      and(eq(userRoles.userId, userId), inArray(userRoles.roleId, roleIds)),
    );
  return res.rowCount ?? 0;
}
