import { conn } from "../../abstraction/context.js";
import { sampleWhere } from "../../dto/sample.js";
import { samples } from "../../model/sample.js";

// findOne returns the first match without ordering (like GORM Take), or undefined.
export async function findOne(ctx, f) {
  const q = conn(ctx)
    .select()
    .from(samples)
    .where(sampleWhere(f))
    .limit(1)
    .$dynamic();
  const [row] = await (f.forUpdate ? q.for("update") : q);
  return row;
}
