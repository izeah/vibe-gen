# Copy to .env (git-ignored) and fill in real values. Never commit .env.
APP_NAME={{.ProjectSlug}}
APP_ENV=local
APP_PORT=3000
# Optional prefix when the API itself must serve under a path (usually the reverse proxy adds it).
APP_BASE_PATH=
# Comma-separated browser origins for CORS; empty = CORS off (browsers go through the BFF).
APP_CORS_ALLOW_ORIGIN=
# Express/Hono "trust proxy": number of hops or comma-separated proxy IPs; empty = trust none.
APP_TRUST_PROXY=
# SPA without a BFF (React/Vue): refresh token in an HttpOnly cookie (Path=<APP_BASE_PATH>/v1/auth),
# access token in the SPA's memory. Requires APP_CORS_ALLOW_ORIGIN = the exact SPA origin (same site).
AUTH_COOKIE_MODE=false
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres
DB_SSLMODE=disable

REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

AUTH_PRIVATE_KEY_PATH=./secret-auth/privateKey.pem
AUTH_PUBLIC_KEY_PATH=./secret-auth/pubKey.pem
AUTH_ACCESS_TOKEN_TTL_MIN=15
AUTH_REFRESH_TOKEN_TTL_MIN=10080
