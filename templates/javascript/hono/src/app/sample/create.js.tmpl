import { created } from "../../abstraction/response.js";
import { parse } from "../../abstraction/validate.js";
import { sampleCreateRequest } from "../../dto/sample.js";
import { body as readBody } from "../../middleware/error.js";

// POST /v1/samples
export const create = (h) => async (c) => {
  const body = parse(sampleCreateRequest, await readBody(c));
  return c.json(created(await h.sampleService.create(c.var.ctx, body)), 201);
};
