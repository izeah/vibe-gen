import {
  deliver,
  guard,
  refreshTokenOf,
} from "../../abstraction/auth-cookie.js";
import { success } from "../../abstraction/response.js";
import { body as readBody } from "../../middleware/error.js";
import { cookieIO } from "./handler.js";

// POST /v1/auth/refresh (refresh token from the body, or only from the cookie in cookie mode)
export const refresh = (h) => async (c) => {
  const io = cookieIO(c);
  guard(h.config, io);
  const body = await refreshTokenOf(h.config, io, () => readBody(c));
  const tokens = await h.authService.refresh(c.var.ctx, body);
  return c.json(success(deliver(h.config, io, tokens)));
};
