import { created } from "../../abstraction/response.js";
import { parse } from "../../abstraction/validate.js";
import { userCreateRequest } from "../../dto/user.js";
import { body as readBody } from "../../middleware/error.js";

// POST /v1/users (admin)
export const create = (h) => async (c) => {
  const body = parse(userCreateRequest, await readBody(c));
  return c.json(created(await h.userService.create(c.var.ctx, body)), 201);
};
