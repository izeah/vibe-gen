package psql

import (
	"database/sql"
	"fmt"
	"log"
	"os"
	"time"

	"golang.org/x/crypto/ssh"
	"gorm.io/driver/postgres"
	"gorm.io/gorm"
	"gorm.io/gorm/logger"
	"gorm.io/plugin/dbresolver"
	"gorm.io/plugin/opentelemetry/tracing"
)

// DBConfig holds the configuration for a single PostgreSQL instance.
type DBConfig struct {
	Host    string
	User    string
	Pass    string
	Port    string
	Name    string
	SslMode string
	Tz      string

	// SSHClient is optional. Set it if the DB is tunneled via SSH.
	SSHClient *ssh.Client
}

// Config holds the write and read replica configurations.
type Config struct {
	Write DBConfig
	Read  []DBConfig
}

var dblogger = logger.New(
	log.New(os.Stdout, "\r\n", log.LstdFlags),
	logger.Config{
		SlowThreshold:             200 * time.Millisecond,
		LogLevel:                  logger.Warn,
		IgnoreRecordNotFoundError: false,
		Colorful:                  true,
	},
)

// DSN builds the write-connection DSN string.
func (c Config) DSN() string {
	return fmt.Sprintf(
		"host=%s user=%s password=%s dbname=%s port=%s sslmode=%s TimeZone=%s",
		c.Write.Host, c.Write.User, c.Write.Pass, c.Write.Name, c.Write.Port, c.Write.SslMode, c.Write.Tz,
	)
}

// Open opens the GORM connection with optional SSH tunnel and read replicas via dbresolver.
func (c Config) Open() (*gorm.DB, error) {
	dialector := postgres.Open(c.DSN())

	// If write DB is behind SSH, use a registered custom driver.
	if c.Write.SSHClient != nil {
		driverName := fmt.Sprintf("postgres+ssh+%s+write", c.Write.SSHClient.LocalAddr().String())
		registerDriver(driverName, c.Write.SSHClient)
		dialector = postgres.New(postgres.Config{DriverName: driverName, DSN: c.DSN()})
	}

	db, err := gorm.Open(dialector, &gorm.Config{
		Logger:                 dblogger.LogMode(logger.Info),
		SkipDefaultTransaction: true,
		PrepareStmt:            true,
	})
	if err != nil {
		return nil, fmt.Errorf("open write DB: %w", err)
	}

	if err = db.Use(tracing.NewPlugin(
		tracing.WithoutQueryVariables(),
		tracing.WithoutMetrics(),
		tracing.WithoutServerAddress(),
		tracing.WithRecordStackTrace(),
	)); err != nil {
		return nil, fmt.Errorf("enable db tracing: %w", err)
	}

	// Configure read replicas if provided.
	if len(c.Read) > 0 {
		var replicas []gorm.Dialector
		for i, rc := range c.Read {
			dsn := fmt.Sprintf(
				"host=%s user=%s password=%s dbname=%s port=%s sslmode=%s TimeZone=%s",
				rc.Host, rc.User, rc.Pass, rc.Name, rc.Port, rc.SslMode, rc.Tz,
			)
			d := postgres.Open(dsn)
			if rc.SSHClient != nil {
				dn := fmt.Sprintf("postgres+ssh+%s+read_%d", rc.SSHClient.LocalAddr().String(), i)
				registerDriver(dn, rc.SSHClient)
				d = postgres.New(postgres.Config{DriverName: dn, DSN: dsn})
			}
			replicas = append(replicas, d)
		}
		if err = db.Use(dbresolver.Register(dbresolver.Config{
			Replicas:          replicas,
			TraceResolverMode: true,
		}).
			SetConnMaxIdleTime(time.Hour).
			SetConnMaxLifetime(5 * time.Minute).
			SetMaxIdleConns(5).
			SetMaxOpenConns(10),
		); err != nil {
			return nil, fmt.Errorf("register replicas: %w", err)
		}
	}

	return db, nil
}

// registerDriver registers a custom ViaSSH postgres driver (idempotent).
func registerDriver(name string, client *ssh.Client) {
	for _, d := range sql.Drivers() {
		if d == name {
			return
		}
	}
	sql.Register(name, &ViaSSHDialer{Client: client})
}
