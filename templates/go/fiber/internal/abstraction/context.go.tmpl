package abstraction

import (
	"context"
	"time"
	"uuid"

	"github.com/gofiber/fiber/v2"
	"gorm.io/gorm"
)

// TrxContext wraps a transactional *gorm.DB.
type TrxContext struct {
	Db *gorm.DB
}

// Context wraps *fiber.Ctx with application-specific fields.
type Context struct {
	*fiber.Ctx

	// Auth holds the authenticated user claims extracted from JWT.
	Auth *AuthContext

	// Trx holds an active database transaction.
	Trx *TrxContext

	// OtherContext is an alternative context.Context for non-fiber code paths.
	OtherContext *context.Context

	// Now returns the frozen request time.
	Now func() time.Time

	// PartnerID is the service partner identifier.
	PartnerID string

	// CountryCode is the service country code.
	CountryCode *string

	// PermissionScope is what middleware.RequirePermission granted for this route:
	// "any" row, or "own" = only rows the user created. Services read it via OwnerID.
	PermissionScope string
}

// AuthContext holds the decoded JWT payload. Roles are not in the token: middleware reads
// them per request (serviceauthz, cached), so a role change applies at once.
type AuthContext struct {
	ID     uuid.UUID `json:"id"`
	UserID string    `json:"user_id"`
}

// NewContext wraps a *fiber.Ctx with application context.
func NewContext(c *fiber.Ctx) *Context {
	return &Context{Ctx: c}
}

// GetContext retrieves the *Context from fiber.Ctx locals or creates a new one.
func GetContext(c *fiber.Ctx) *Context {
	if val := c.Locals("context"); val != nil {
		if ctx, ok := val.(*Context); ok {
			return ctx
		}
	}
	return NewContext(c)
}

// RequestContext returns the request-scoped context.Context (cancellation, deadlines,
// trace spans) for calls into Redis, HTTP clients, etc.
func (c *Context) RequestContext() context.Context {
	return c.UserContext()
}

// OwnerID is the user a query must be limited to (created_by) when the route's permission is
// scoped to the user's own rows, or "" when any row is allowed.
func (c *Context) OwnerID() string {
	if c.PermissionScope == "own" && c.Auth != nil {
		return c.Auth.ID.String()
	}
	return ""
}
