package serviceuser

import (
	"net/http"
	"time"
	"uuid"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/internal/model"
	"{{.ModuleName}}/pkg/response"
)

func (s *service) Create(ctx *abstraction.Context, req *dto.UserCreateRequest) (*dto.UserResponse, error) {
	m := &model.User{
		Context: ctx,
		UserEntity: model.UserEntity{
			Name:     req.Name,
			Email:    req.Email,
			Password: req.Password,
			Role:     req.Role,
		},
	}
	if res := s.userRepository.Create(ctx, m); res.Error != nil {
		return nil, response.ErrorBuilder(http.StatusInternalServerError, res.Error)
	}
	r := &dto.UserResponse{
		ID:        m.ID.String(),
		Name:      m.Name,
		Email:     m.Email,
		Role:      m.Role,
		CreatedAt: time.Unix(0, m.CreatedAt).UTC().Format("2006-01-02T15:04:05Z07:00"),
	}
	if m.UpdatedAt != nil {
		r.UpdatedAt = time.Unix(0, *m.UpdatedAt).UTC().Format("2006-01-02T15:04:05Z07:00")
	}
	if m.CreatedBy != uuid.Nil() {
		r.CreatedBy = m.CreatedBy.String()
	}
	if m.UpdatedBy != nil {
		updStr := m.UpdatedBy.String()
		r.UpdatedBy = &updStr
	}
	return r, nil
}

