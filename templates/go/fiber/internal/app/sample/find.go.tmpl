package sample

import (
	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
)

// Find lists samples with pagination.
// @Summary     List samples
// @Tags        sample
// @Produce     json
// @Param       page       query  int  false  "Page number"
// @Param       page_size  query  int  false  "Items per page"
// @Success     200        {object}  response.Base
// @Security    BearerAuth
// @Router      /v1/samples [get]
func (h *Handler) Find(c *fiber.Ctx) (err error) {
	var (
		ctx  = abstraction.GetContext(c)
		data []*dto.SampleResponse
		info *abstraction.PaginationInfo
	)

	f := new(dto.SampleFilter)
	if err = c.QueryParser(f); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}

	f.Pagination = new(abstraction.Pagination)
	if err = c.QueryParser(f.Pagination); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}

	if data, info, err = h.SampleService.Find(ctx, f); err != nil {
		return response.ErrorResponse(err).Send(c)
	}
	return response.SuccessListResponse(data, info).Send(c)
}
