package auth

import (
	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
)

// Login authenticates a user and returns a token pair.
// @Summary     Login
// @Tags        auth
// @Accept      json
// @Produce     json
// @Param       body  body      dto.LoginRequest  true  "Login credentials"
// @Success     200   {object}  response.Base
// @Router      /v1/auth/login [post]
func (h *Handler) Login(c *fiber.Ctx) (err error) {
	var (
		ctx     = abstraction.GetContext(c)
		payload = new(dto.LoginRequest)
		data    *dto.LoginResponse
	)
	if err = c.BodyParser(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if data, err = h.AuthService.Login(ctx, payload); err != nil {
		return response.ErrorResponse(err).Send(c)
	}
	return response.SuccessResponse(data).Send(c)
}
