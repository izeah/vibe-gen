package auth

import (
	"github.com/gofiber/fiber/v2"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/config"
	"{{.ModuleName}}/internal/dto"
	authcookie "{{.ModuleName}}/pkg/auth-cookie"
	authtoken "{{.ModuleName}}/pkg/auth-token"
	"{{.ModuleName}}/pkg/response"
	"{{.ModuleName}}/pkg/validator"
)

// Refresh exchanges a valid refresh token for a new token pair.
// @Summary     Refresh access token
// @Tags        auth
// @Accept      json
// @Produce     json
// @Param       body  body      dto.RefreshRequest  true  "Refresh token"
// @Success     200   {object}  response.Base
// @Router      /v1/auth/refresh [post]
func (h *Handler) Refresh(c *fiber.Ctx) (err error) {
	var (
		ctx     = abstraction.GetContext(c)
		payload = new(dto.RefreshRequest)
		data    *dto.LoginResponse
	)
	cfg := config.App()
	// Cookie mode reads the refresh token from the HttpOnly cookie, never from the body.
	if cfg.AuthCookieMode {
		payload.RefreshToken = c.Cookies(authcookie.Name)
	} else if err = c.BodyParser(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if err = validator.Struct(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if data, err = h.AuthService.Refresh(ctx, payload); err != nil {
		return response.ErrorResponse(err).Send(c)
	}
	if cfg.AuthCookieMode {
		_, refreshLifetime := authtoken.Lifetimes()
		c.Append(fiber.HeaderSetCookie, authcookie.New(data.RefreshToken, refreshLifetime, cfg.BasePath).String())
		data.RefreshToken = ""
	}
	return response.SuccessResponse(data).Send(c)
}
