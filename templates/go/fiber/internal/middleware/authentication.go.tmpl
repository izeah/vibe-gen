package middleware

import (
	"strings"
	"uuid"

	"github.com/gofiber/fiber/v2"
	authtoken "{{.ModuleName}}/pkg/auth-token"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/pkg/response"
)

// Authentication returns a Fiber middleware that validates Bearer JWT tokens.
func Authentication() fiber.Handler {
	return func(c *fiber.Ctx) error {
		authHeader := c.Get("Authorization")
		if authHeader == "" || !strings.HasPrefix(authHeader, "Bearer ") {
			return response.ErrorConstant.Unauthorized.Send(c)
		}

		tokenStr := strings.TrimPrefix(authHeader, "Bearer ")
		claims, err := authtoken.ClaimsFromAccessToken(tokenStr)
		if err != nil {
			return response.ErrorConstant.Unauthorized.WithMessage("invalid or expired token").Send(c)
		}

		uidStr := claims.Subject
		var uid uuid.UUID
		if uidStr != "" {
			uid, _ = uuid.Parse(uidStr)
		}

		auth := &abstraction.AuthContext{
			ID:     uid,
			UserID: uidStr,
		}
		c.Locals("auth", auth)
		// Audit columns (created_by/updated_by/deleted_by) read ctx.Auth.
		abstraction.GetContext(c).Auth = auth
		return c.Next()
	}
}
