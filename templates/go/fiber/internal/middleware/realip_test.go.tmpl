package middleware

import (
	"io"
	"net/http/httptest"
	"testing"

	"github.com/gofiber/fiber/v2"
)

func TestClientIP(t *testing.T) {
	// app.Test's socket address is 0.0.0.0, so it plays the trusted proxy here.
	if err := SetTrustedProxies([]string{"0.0.0.0", "10.0.0.0/8"}); err != nil {
		t.Fatal(err)
	}
	defer SetTrustedProxies(nil)

	app := fiber.New()
	app.Get("/", func(c *fiber.Ctx) error { return c.SendString(ClientIP(c)) })
	for xff, want := range map[string]string{
		"":                           "0.0.0.0",
		"9.9.9.9":                    "9.9.9.9",
		"1.2.3.4, 9.9.9.9":           "9.9.9.9", // the client-supplied left entry is ignored
		"1.2.3.4, 9.9.9.9, 10.0.0.1": "9.9.9.9", // right-most hop that is not a trusted proxy
		"not-an-ip, 10.0.0.1":        "10.0.0.1",
	} {
		req := httptest.NewRequest("GET", "/", nil)
		if xff != "" {
			req.Header.Set("X-Forwarded-For", xff)
		}
		res, err := app.Test(req)
		if err != nil {
			t.Fatal(err)
		}
		got, _ := io.ReadAll(res.Body)
		if string(got) != want {
			t.Errorf("X-Forwarded-For %q: got %q, want %q", xff, got, want)
		}
	}
}
