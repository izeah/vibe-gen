PORT=3000
APP_NAME={{.ProjectSlug}}
LOG_LEVEL=debug

# Database — local Docker PostgreSQL (start with: make pg-start)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres
DB_SSLMODE=disable

# Redis — local Docker Redis (start with: make redis-start)
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=

# Crypto — RSA keys for JWT signing (base64 or PEM path)
CRYPTO_PRIVATE_KEY="./secret-auth/privateKey.pem"
CRYPTO_PUBLIC_KEY="./secret-auth/pubKey.pem"
OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"
CRYPTO_ACCESS_TOKEN_LIFETIME=60
CRYPTO_REFRESH_TOKEN_LIFETIME=10080

# OpenTelemetry (optional)
OTEL_HOST_GRPC=

# Rate limiting
RATE_LIMIT=100
RATE_LIMIT_WINDOW_SEC=60

# Midtrans — dummy credentials for local/testing; developer sets real keys for staging/production
MIDTRANS_SERVER_KEY=SB-Mid-server-dummy-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-dummy-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_URL=https://api.sandbox.midtrans.com

# Third-party sample API
THIRDPARTY_SAMPLE_HOST=https://api.sandbox.sample.com
THIRDPARTY_SAMPLE_API_KEY=dummy-api-key


OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"

