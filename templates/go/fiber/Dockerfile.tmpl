FROM golang:1.27-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /build/app main.go

FROM alpine:3.21
WORKDIR /usr/app
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /build/app .
EXPOSE 3000
ENTRYPOINT ["/usr/app/app"]
