package authtoken

import (
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
	"testing"
	"time"

	"{{.ModuleName}}/internal/config"
)

func generateTestKeys(t *testing.T) ([]byte, []byte) {
	t.Helper()
	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
	if err != nil {
		t.Fatal(err)
	}
	privPEM := pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(privateKey)})
	pubBytes, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
	if err != nil {
		t.Fatal(err)
	}
	return privPEM, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: pubBytes})
}

// useConfig swaps the config readers for the test (keys, issuer "svc", 1h / 24h lifetimes).
func useConfig(t *testing.T, priv, pub []byte) {
	t.Helper()
	oldKey, oldIssuer, oldNow := authKey, issuer, now
	t.Cleanup(func() { authKey, issuer, now = oldKey, oldIssuer, oldNow })
	authKey = func() *config.AuthKeyConfig {
		return &config.AuthKeyConfig{PemDataPrivate: priv, PemDataPublic: pub, AccessTokenLifetime: time.Hour, RefreshTokenLifetime: 24 * time.Hour}
	}
	issuer = func() string { return "svc" }
	now = time.Now
}

func TestAccessAndRefreshTokens(t *testing.T) {
	privPEM, pubPEM := generateTestKeys(t)
	useConfig(t, privPEM, pubPEM)

	tok := New(&AddtionalClaims{TokenId: "jti-1", RefreshTokenId: "jti-2", UserId: "user-1", FamilyId: "fam-1"})
	// Refresh first: signing it must not change the access token's claims.
	refresh, err := tok.RefreshToken()
	if err != nil {
		t.Fatal(err)
	}
	access, err := tok.AccessToken()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := New(&AddtionalClaims{TokenId: "j", UserId: "u"}).RefreshToken(); err == nil {
		t.Error("refresh token without RefreshTokenId/FamilyId must fail")
	}

	got, err := ClaimsFromAccessToken(access)
	if err != nil || got.Subject != "user-1" || got.ID != "jti-1" || got.FamilyId != "" || got.Issuer != "svc" {
		t.Fatalf("valid access token rejected or wrong claims: %v %+v", err, got)
	}
	if !got.ExpiresAt.Time.Before(time.Now().Add(2 * time.Hour)) {
		t.Fatalf("access token took the refresh expiry: %v", got.ExpiresAt)
	}
	rc, err := ClaimsFromRefreshToken(refresh)
	if err != nil || rc.FamilyId != "fam-1" || rc.ID != "jti-2" || !rc.ExpiresAt.Time.After(time.Now().Add(20*time.Hour)) {
		t.Fatalf("valid refresh token rejected or wrong claims: %v %+v", err, rc)
	}

	// Signed an hour and a half ago: the access token (1h) has expired, the refresh one (24h) not.
	now = func() time.Time { return time.Now().Add(-90 * time.Minute) }
	old := New(&AddtionalClaims{TokenId: "j", RefreshTokenId: "r", UserId: "u", FamilyId: "f"})
	expired, _ := old.AccessToken()
	stillValid, _ := old.RefreshToken()
	now = time.Now
	if _, err := ClaimsFromRefreshToken(stillValid); err != nil {
		t.Errorf("refresh token within its lifetime rejected: %v", err)
	}

	reject := map[string]func() error{
		"refresh used as access": func() error { _, e := ClaimsFromAccessToken(refresh); return e },
		"access used as refresh": func() error { _, e := ClaimsFromRefreshToken(access); return e },
		"expired":                func() error { _, e := ClaimsFromAccessToken(expired); return e },
		"garbage":                func() error { _, e := ClaimsFromAccessToken("not.a.jwt"); return e },
		"wrong issuer/audience": func() error {
			issuer = func() string { return "other" }
			defer func() { issuer = func() string { return "svc" } }()
			_, e := ClaimsFromAccessToken(access)
			return e
		},
		"wrong key": func() error {
			_, otherPub := generateTestKeys(t)
			useConfig(t, privPEM, otherPub)
			defer useConfig(t, privPEM, pubPEM)
			_, e := ClaimsFromAccessToken(access)
			return e
		},
	}
	for name, f := range reject {
		if f() == nil {
			t.Errorf("%s: expected rejection", name)
		}
	}
}
