package response

import (
	"encoding/json"
	"fmt"
	"net/http"
	"strings"

	"github.com/go-playground/validator/v10"
	"github.com/labstack/echo/v4"
	pkgerrors "github.com/pkg/errors"

	"{{.ModuleName}}/internal/abstraction"
)

// ── Error message constants ───────────────────────────────────────────────────

const (
	E_BAD_REQUEST           = "bad request"
	E_DUPLICATE             = "duplicate"
	E_NOT_FOUND             = "not found"
	E_UNAUTHORIZED          = "unauthorized"
	E_FORBIDDEN             = "forbidden"
	E_UNPROCESSABLE_ENTITY  = "unprocessable entity"
	E_INTERNAL_SERVER_ERROR = "internal server error"
)

// ── Meta ─────────────────────────────────────────────────────────────────────

// Meta is the standard response metadata envelope.
type Meta struct {
	Success      bool                        `json:"success"`
	Message      string                      `json:"message"`
	Info         *abstraction.PaginationInfo `json:"info,omitempty"`
	Filter       interface{}                 `json:"filter,omitempty"`
	RowsAffected *int64                      `json:"rows_affected,omitempty"`
}

// ── Error types ───────────────────────────────────────────────────────────────

type errorResponse struct {
	Meta        Meta        `json:"meta"`
	Data        interface{} `json:"data"`
	Description interface{} `json:"description,omitempty"`
}

// Error is the application error type. It implements the error interface.
type Error struct {
	// Header holds additional HTTP headers to be sent with the error response.
	Header   *http.Header
	Response errorResponse `json:"response"`
	Code     int           `json:"code"`
	Err      error
}

// Error implements the error interface.
func (e *Error) Error() string {
	if e.Err != nil {
		return e.Err.Error()
	}
	return e.Response.Meta.Message
}

// WithError attaches an underlying error.
func (e *Error) WithError(err error) *Error {
	e.Err = pkgerrors.WithStack(err)
	if e.Response.Meta.Message == "" && err != nil {
		e.Response.Meta.Message = err.Error()
	}
	return e
}

// WithData attaches response data.
func (e *Error) WithData(data interface{}) *Error {
	e.Response.Data = data
	return e
}

// WithDescription attaches a description (e.g. validation field errors).
func (e *Error) WithDescription(desc interface{}) *Error {
	e.Response.Description = desc
	return e
}

// WithMetaMessage overrides the meta message.
func (e *Error) WithMetaMessage(msg string) *Error {
	e.Response.Meta.Message = msg
	return e
}

// WithHeader sets additional response headers.
func (e *Error) WithHeader(h *http.Header) *Error {
	e.Header = h
	return e
}

// WithMessage overrides the meta message (alias for WithMetaMessage).
func (e *Error) WithMessage(msg string) *Error {
	return e.WithMetaMessage(msg)
}

// Send writes the error response to the echo.Context, including any extra headers.
func (e *Error) Send(c echo.Context) error {
	if e.Header != nil {
		for k, values := range *e.Header {
			for _, v := range values {
				c.Response().Header().Add(k, v)
			}
		}
	}
	return c.JSON(e.Code, e.Response)
}

// ── ErrorConstant ─────────────────────────────────────────────────────────────

// ErrorConstant provides pre-built typed errors for common HTTP status codes.
var ErrorConstant = struct {
	BadRequest          *Error
	Unauthorized        *Error
	Forbidden           *Error
	NotFound            *Error
	RouteNotFound       *Error
	MethodNotAllowed    *Error
	Duplicate           *Error
	UnprocessableEntity *Error
	InternalServerError *Error
}{
	BadRequest:          newConstantError(http.StatusBadRequest, E_BAD_REQUEST),
	Unauthorized:        newConstantError(http.StatusUnauthorized, E_UNAUTHORIZED),
	Forbidden:           newConstantError(http.StatusForbidden, E_FORBIDDEN),
	NotFound:            newConstantError(http.StatusNotFound, E_NOT_FOUND),
	RouteNotFound:       newConstantError(http.StatusNotFound, "route not found"),
	MethodNotAllowed:    newConstantError(http.StatusMethodNotAllowed, "method not allowed"),
	Duplicate:           newConstantError(http.StatusConflict, E_DUPLICATE),
	UnprocessableEntity: newConstantError(http.StatusUnprocessableEntity, E_UNPROCESSABLE_ENTITY),
	InternalServerError: newConstantError(http.StatusInternalServerError, E_INTERNAL_SERVER_ERROR),
}

func newConstantError(code int, message string) *Error {
	return &Error{
		Response: errorResponse{
			Meta: Meta{Success: false, Message: message},
		},
		Code: code,
	}
}

// ── Error builders ────────────────────────────────────────────────────────────

// ErrorBuilder creates a generic *Error with the given status code and error.
func ErrorBuilder(code int, err error, messages ...interface{}) *Error {
	msg := E_UNPROCESSABLE_ENTITY
	if len(messages) > 0 {
		msg = fmt.Sprint(messages[0])
	}
	return &Error{
		Response: errorResponse{
			Meta: Meta{Success: false, Message: msg},
		},
		Code: code,
		Err:  pkgerrors.WithStack(err),
	}
}

// ErrorBadRequest builds a detailed *Error from echo.HTTPError, validator.ValidationErrors, *Error, or generic errors.
func ErrorBadRequest(err error) *Error {
	if err == nil {
		return nil
	}

	// Already an *Error — return as-is.
	var eR *Error
	if pkgerrors.As(err, &eR) {
		return eR
	}

	// echo.HTTPError (e.g. binding failure).
	var e *echo.HTTPError
	if pkgerrors.As(err, &e) {
		var (
			data                map[string]interface{}
			message             = E_BAD_REQUEST
			eUnmarshalTypeError *json.UnmarshalTypeError
		)
		if pkgerrors.As(e.Internal, &eUnmarshalTypeError) {
			data = map[string]interface{}{
				eUnmarshalTypeError.Field: map[string]interface{}{
					"message": fmt.Sprintf("should be %s!", eUnmarshalTypeError.Type),
				},
			}
		} else {
			var eSyntaxError *json.SyntaxError
			if pkgerrors.As(e.Internal, &eSyntaxError) {
				message = eSyntaxError.Error()
			}
		}
		return &Error{
			Response: errorResponse{
				Meta:        Meta{Success: false, Message: message},
				Description: data,
			},
			Code: http.StatusBadRequest,
			Err:  pkgerrors.WithStack(err),
		}
	}

	// go-playground validation errors.
	var errValidation validator.ValidationErrors
	if pkgerrors.As(err, &errValidation) {
		data := make(map[string]interface{})
		for _, ef := range errValidation {
			data[strings.ToLower(ef.Field())] = map[string]string{
				"field":   ef.Field(),
				"tag":     ef.Tag(),
				"param":   ef.Param(),
				"message": validationMessage(ef),
			}
		}
		return &Error{
			Response: errorResponse{
				Meta:        Meta{Success: false, Message: E_BAD_REQUEST},
				Description: data,
			},
			Code: http.StatusBadRequest,
			Err:  pkgerrors.WithStack(err),
		}
	}

	return ErrorBuilder(http.StatusBadRequest, err)
}

// ErrorResponse wraps any error into a 500 *Error for use in handlers.
// If the error is already an *Error, it is returned unchanged.
func ErrorResponse(err error) *Error {
	var e *Error
	if pkgerrors.As(err, &e) {
		return e
	}
	return ErrorBuilder(http.StatusInternalServerError, err)
}

// validationMessage translates a go-playground FieldError into a human-readable message.
func validationMessage(fe validator.FieldError) string {
	switch fe.Tag() {
	case "required":
		return fmt.Sprintf("%s is required", fe.Field())
	case "email":
		return fmt.Sprintf("%s must be a valid email", fe.Field())
	case "min":
		return fmt.Sprintf("%s must be at least %s characters", fe.Field(), fe.Param())
	case "max":
		return fmt.Sprintf("%s must be at most %s characters", fe.Field(), fe.Param())
	case "oneof":
		return fmt.Sprintf("%s must be one of: %s", fe.Field(), fe.Param())
	default:
		return fmt.Sprintf("%s is invalid (%s)", fe.Field(), fe.Tag())
	}
}

// ── Success response types ────────────────────────────────────────────────────

// Base is the standard API success response envelope.
type Base struct {
	Meta Meta        `json:"meta"`
	Data interface{} `json:"data,omitempty"`
}

type apiResponse struct {
	code int
	body Base
}

func (r *apiResponse) Send(c echo.Context) error {
	return c.JSON(r.code, r.body)
}

// SuccessResponse returns a 200 JSON response.
func SuccessResponse(data interface{}) *apiResponse {
	return &apiResponse{
		code: http.StatusOK,
		body: Base{Meta: Meta{Success: true, Message: "OK"}, Data: data},
	}
}

// SuccessListResponse returns a 200 JSON response with pagination info.
func SuccessListResponse(data interface{}, info *abstraction.PaginationInfo) *apiResponse {
	return &apiResponse{
		code: http.StatusOK,
		body: Base{Meta: Meta{Success: true, Message: "OK", Info: info}, Data: data},
	}
}

// CreatedResponse returns a 201 JSON response.
func CreatedResponse(data interface{}) *apiResponse {
	return &apiResponse{
		code: http.StatusCreated,
		body: Base{Meta: Meta{Success: true, Message: "Created"}, Data: data},
	}
}
