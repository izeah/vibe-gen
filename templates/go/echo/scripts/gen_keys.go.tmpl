//go:build ignore

package main

import (
	"crypto/rand"
	"crypto/rsa"
	"crypto/x509"
	"encoding/pem"
	"fmt"
	"os"
	"path/filepath"
)

func main() {
	targetDir := "./secret-auth"
	if err := os.MkdirAll(targetDir, 0700); err != nil {
		fmt.Printf("Failed to create directory %s: %v\n", targetDir, err)
		os.Exit(1)
	}

	privPath := filepath.Join(targetDir, "privateKey.pem")
	pubPath := filepath.Join(targetDir, "pubKey.pem")

	if err := generateRSAKeyPair(privPath, pubPath, 2048); err != nil {
		fmt.Printf("Error generating keypair: %v\n", err)
		os.Exit(1)
	}
	fmt.Printf("✓ Generated %s and %s\n", privPath, pubPath)
	fmt.Println("\nRSA auth keys generated successfully in ./secret-auth/")
}

func generateRSAKeyPair(privPath, pubPath string, bits int) error {
	// Generate private key
	privateKey, err := rsa.GenerateKey(rand.Reader, bits)
	if err != nil {
		return fmt.Errorf("generating RSA key: %w", err)
	}

	// Encode private key to PKCS#8 PEM
	privASN1, err := x509.MarshalPKCS8PrivateKey(privateKey)
	if err != nil {
		privASN1 = x509.MarshalPKCS1PrivateKey(privateKey)
	}
	privBlock := &pem.Block{
		Type:  "PRIVATE KEY",
		Bytes: privASN1,
	}
	privFile, err := os.OpenFile(privPath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0600)
	if err != nil {
		return fmt.Errorf("creating private key file: %w", err)
	}
	defer privFile.Close()
	if err := pem.Encode(privFile, privBlock); err != nil {
		return fmt.Errorf("writing private key PEM: %w", err)
	}

	// Encode public key to PKIX PEM
	pubASN1, err := x509.MarshalPKIXPublicKey(&privateKey.PublicKey)
	if err != nil {
		return fmt.Errorf("marshaling public key: %w", err)
	}
	pubBlock := &pem.Block{
		Type:  "PUBLIC KEY",
		Bytes: pubASN1,
	}
	pubFile, err := os.OpenFile(pubPath, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0644)
	if err != nil {
		return fmt.Errorf("creating public key file: %w", err)
	}
	defer pubFile.Close()
	if err := pem.Encode(pubFile, pubBlock); err != nil {
		return fmt.Errorf("writing public key PEM: %w", err)
	}

	return nil
}
