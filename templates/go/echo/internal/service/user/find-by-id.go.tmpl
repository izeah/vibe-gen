package serviceuser

import (
	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
)

func (s *service) FindByID(ctx *abstraction.Context, req *dto.UserFindByIDRequest) (*dto.UserResponse, error) {
	user, err := s.userRepository.FindOne(ctx, (&dto.UserFilter{IDs: []string{req.ID}}).Scopes(s.withRoles))
	if err != nil {
		return nil, response.ErrorConstant.NotFound.WithMessage("user not found")
	}
	return s.toUserResponse(user), nil
}
