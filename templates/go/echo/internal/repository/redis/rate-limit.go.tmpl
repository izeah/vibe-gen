package redis

import (
	"context"
	"errors"

	"github.com/redis/go-redis/v9"
)

// RateLimitRepository counts attempts per key in a fixed window.
type RateLimitRepository interface {
	// Hit atomically increments key (starting a windowSec window on the first hit) and
	// returns the new count and the seconds left in the window. Check the count BEFORE doing
	// the guarded work, so parallel requests cannot all pass a stale read.
	Hit(ctx context.Context, key string, windowSec int) (count int64, ttlSec int, err error)
	// Undo takes back one hit (e.g. the attempt turned out to be allowed and should not count).
	Undo(ctx context.Context, key string) error
	// Reset clears the key.
	Reset(ctx context.Context, key string) error
}

type rateLimit struct {
	client *redis.Client
}

func NewRateLimit(client *redis.Client) RateLimitRepository {
	return &rateLimit{client: client}
}

var hitScript = redis.NewScript(`
local count = redis.call('INCR', KEYS[1])
if count == 1 then redis.call('EXPIRE', KEYS[1], ARGV[1]) end
return {count, redis.call('TTL', KEYS[1])}
`)

func (r *rateLimit) Hit(ctx context.Context, key string, windowSec int) (int64, int, error) {
	res, err := hitScript.Run(ctx, r.client, []string{key}, windowSec).Int64Slice()
	if err != nil {
		return 0, 0, err
	}
	if len(res) != 2 {
		return 0, 0, errors.New("rate limit: unexpected script result")
	}
	ttl := int(res[1])
	if ttl < 0 {
		ttl = windowSec
	}
	return res[0], ttl, nil
}

func (r *rateLimit) Undo(ctx context.Context, key string) error {
	return r.client.Decr(ctx, key).Err()
}

func (r *rateLimit) Reset(ctx context.Context, key string) error {
	return r.client.Del(ctx, key).Err()
}
