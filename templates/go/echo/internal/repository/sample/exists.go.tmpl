package repositorysample

import (
	"gorm.io/gorm"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/internal/model"
)

func (r *repository) Exists(ctx *abstraction.Context, f *dto.SampleFilter) (bool, error) {
	var data int64
	if err := r.CheckTrx(ctx).Model(&model.Sample{}).Scopes(func(tx *gorm.DB) *gorm.DB {
		if f != nil {
			return f.Apply(tx)
		}
		return tx
	}).Count(&data).Error; err != nil {
		return false, err
	}
	return data > 0, nil
}
