package user

import (
	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
)

// SetRoles replaces the roles the user holds (role_ids: [] removes all).
// @Summary     Replace user roles
// @Tags        user
// @Accept      json
// @Produce     json
// @Param       id    path  string                 true  "User ID"
// @Param       body  body  dto.UserSetRolesRequest  true  "Role IDs"
// @Success     200   {object}  response.Base
// @Security    BearerAuth
// @Router      /v1/users/{id}/roles [put]
func (h *Handler) SetRoles(c echo.Context) (err error) {
	var (
		ctx     = c.(*abstraction.Context)
		payload = new(dto.UserSetRolesRequest)
		data    *dto.UserResponse
	)
	if err = c.Bind(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if err = c.Validate(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if data, err = h.UserService.SetRoles(ctx, payload); err != nil {
		return response.ErrorResponse(err).Send(c)
	}
	return response.SuccessResponse(data).Send(c)
}
