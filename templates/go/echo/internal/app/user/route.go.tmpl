package user

import (
	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/middleware"
)

// Route registers user endpoints on the given echo.Group.
// Any authenticated user may read their own profile; managing other users needs a permission
// (users:*), which the seed grants to admin only. Changing a user's roles needs roles:manage:
// users:update alone must not let anyone grant themselves admin.
func (h *Handler) Route(g *echo.Group) {
	can := func(action string) echo.MiddlewareFunc {
		return middleware.RequirePermission(h.AuthzService, "users", action)
	}
	g.GET("/me", h.Me)
	g.GET("/:id", h.FindByID, can("read"))
	g.POST("", h.Create, can("create"))
	g.PUT("/:id", h.Update, can("update"))
	g.PUT("/:id/roles", h.SetRoles, middleware.RequirePermission(h.AuthzService, "roles", "manage"))
}
