package health

import (
	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/pkg/response"
)

// Check returns 200 OK when the service is running.
// @Summary     Health check
// @Tags        health
// @Produce     json
// @Success     200  {object}  response.Base
// @Router      /health [get]
func (h *Handler) Check(c echo.Context) (err error) {
	var (
		ctx  = c.(*abstraction.Context)
		data = map[string]string{"status": "ok"}
	)
	_ = ctx
	return response.SuccessResponse(data).Send(c)
}
