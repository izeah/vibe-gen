package auth

import (
	"github.com/labstack/echo/v4"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/config"
	"{{.ModuleName}}/internal/dto"
	authcookie "{{.ModuleName}}/pkg/auth-cookie"
	"{{.ModuleName}}/pkg/response"
)

// Logout revokes the session (refresh token family) of the given refresh token.
// @Summary     Logout
// @Tags        auth
// @Accept      json
// @Produce     json
// @Param       body  body      dto.RefreshRequest  true  "Refresh token"
// @Success     200   {object}  response.Base
// @Router      /v1/auth/logout [post]
func (h *Handler) Logout(c echo.Context) (err error) {
	var (
		ctx     = c.(*abstraction.Context)
		payload = new(dto.RefreshRequest)
	)
	cfg := config.App()
	// Cookie mode reads the refresh token from the HttpOnly cookie, never from the body.
	if cfg.AuthCookieMode {
		if ck, err := c.Cookie(authcookie.Name); err == nil {
			payload.RefreshToken = ck.Value
		}
	} else if err = c.Bind(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if cfg.AuthCookieMode {
		c.SetCookie(authcookie.Clear(cfg.BasePath)) // always drop the cookie, even if the token is invalid
	}
	if err = c.Validate(payload); err != nil {
		return response.ErrorBadRequest(err).Send(c)
	}
	if err = h.AuthService.Logout(ctx, payload); err != nil {
		return response.ErrorResponse(err).Send(c)
	}
	return response.SuccessResponse(nil).Send(c)
}
