package dto

import (
	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{.ModuleName}}/internal/abstraction"
)

// roleSortColumns is the ORDER BY allowlist for RoleFilter (API field → DB column).
var roleSortColumns = abstraction.SortColumns{
	"code":       "roles.code",
	"name":       "roles.name",
	"created_at": "roles.created_at",
}

// RoleFilter is the query filter for roles.
type RoleFilter struct {
	*abstraction.Pagination
	Sorts     []abstraction.SortItem `json:"sorts,omitempty" query:"sorts"`
	IDs       []string               `json:"ids"             query:"ids"`
	Codes     []string               `json:"codes"           query:"codes"`
	ForCount  bool                   `json:"-"`
	ForUpdate bool                   `json:"-"`
	clauses   []clause.Expression
	scopes    []func(*gorm.DB) *gorm.DB
}

// Clauses appends GORM clause expressions (e.g. clause.Locking{Strength: "UPDATE"}).
func (f *RoleFilter) Clauses(conds ...clause.Expression) *RoleFilter {
	if f != nil {
		f.clauses = append(f.clauses, conds...)
	}
	return f
}

// Scopes appends custom GORM query scopes.
func (f *RoleFilter) Scopes(funcs ...func(*gorm.DB) *gorm.DB) *RoleFilter {
	if f != nil {
		f.scopes = append(f.scopes, funcs...)
	}
	return f
}

// Order appends SortItem entries.
func (f *RoleFilter) Order(items ...abstraction.SortItem) *RoleFilter {
	if f != nil {
		f.Sorts = append(f.Sorts, items...)
	}
	return f
}

// Apply applies the filter conditions to a GORM query.
func (f *RoleFilter) Apply(tx *gorm.DB) *gorm.DB {
	if f == nil {
		return tx
	}
	if len(f.IDs) > 0 {
		tx = tx.Where("roles.id IN ?", f.IDs)
	}
	if len(f.Codes) > 0 {
		tx = tx.Where("roles.code IN ?", f.Codes)
	}
	for _, c := range f.clauses {
		tx = tx.Clauses(c)
	}
	for _, s := range f.scopes {
		tx = tx.Scopes(s)
	}
	tx = roleSortColumns.Apply(tx, f.Sorts...)
	if !f.ForCount && !f.ForUpdate {
		tx.Select("roles.*")
		if f.Pagination != nil {
			tx = roleSortColumns.Apply(tx, f.Pagination.SortItems()...)
			f.Pagination.Apply(tx)
		}
	}
	return tx
}

