include ./Makefile.Common

SHELL := /bin/sh

ENV         ?= local
CONFIG_FILE ?= ./config.$(ENV).yml
ENV_FILE    ?= .env.$(ENV)

ifeq ($(wildcard $(CONFIG_FILE)),)
  CONFIG_FILE := ./config.yml
endif

ifeq ($(wildcard $(ENV_FILE)),)
  ENV_FILE := .env
endif

# — Local PostgreSQL container —
POSTGRES_CONTAINER ?= {{.ProjectSlug}}-db
POSTGRES_USER      ?= postgres
POSTGRES_PASSWORD  ?= postgres
POSTGRES_DB        ?= postgres
POSTGRES_PORT      ?= 5432
POSTGRES_VOLUME    ?= {{.ProjectSlug}}-db-data

# — Local Redis container —
REDIS_CONTAINER ?= {{.ProjectSlug}}-redis
REDIS_PORT      ?= 6379
REDIS_VOLUME    ?= {{.ProjectSlug}}-redis-data

# — Migrations & CI —
MIGRATE_BIN ?= migrate
MIGRATE_DIR ?= migrations

DOCKER_REGISTRY_HOST ?= local

# -------------------------------------------------------------------
# Tool versions — keep in sync with .gitlab-ci.yml variables block
# -------------------------------------------------------------------
GOLANGCI_LINT_VERSION ?= 2.12.2
GOSEC_VERSION         ?= v2.26.1
GOVULNCHECK_VERSION   ?= v1.3.0
GOIMPORTS_VERSION     ?= v0.45.0

CI_IMAGE ?= $(DOCKER_REGISTRY_HOST)/ci-tools:latest

define load_db_env
  _cfg="$(CONFIG_FILE)"; \
  if [ ! -f "$$_cfg" ]; then echo "ERROR: config file '$$_cfg' not found"; exit 1; fi; \
  _yv() { grep -A 20 "^$$1:" "$$_cfg" | grep "^[[:space:]]*$$2:" | head -1 | sed 's/.*:[[:space:]]*//' | tr -d '"' | sed 's/[[:space:]]*#.*//' | tr -d '\r'; }; \
  DB_HOST=$$(_yv db host); \
  DB_USER=$$(_yv db username); \
  DB_PASS=$$(_yv db password); \
  DB_PORT=$$(_yv db port); \
  DB_NAME=$$(_yv db name_db); \
  DB_SSLMODE=$$(_yv db sslmode); \
  if [ -z "$$DB_HOST" ]; then echo "ERROR: db.host is empty in $$_cfg"; exit 1; fi; \
  if [ -z "$$DB_NAME" ]; then echo "ERROR: db.name_db is empty in $$_cfg"; exit 1; fi; \
  echo "Config: $$_cfg | host=$$DB_HOST port=$$DB_PORT db=$$DB_NAME sslmode=$$DB_SSLMODE";
endef

define load_env
  if [ -f "$(ENV_FILE)" ]; then \
    export $$(grep -v '^#' $(ENV_FILE) | grep -v '^[[:space:]]*$$' | xargs); \
  fi; \
  if [ -z "$$DATABASE_URL" ]; then \
    $(load_db_env) \
    if [ -n "$$DB_PASS" ]; then \
      DATABASE_URL="postgres://$${DB_USER}:$${DB_PASS}@$${DB_HOST}:$${DB_PORT}/$${DB_NAME}?sslmode=$${DB_SSLMODE}"; \
    else \
      DATABASE_URL="postgres://$${DB_USER}@$${DB_HOST}:$${DB_PORT}/$${DB_NAME}?sslmode=$${DB_SSLMODE}"; \
    fi; \
  fi;
endef

.PHONY: help run build swag tidy \
	check-tools install-tools build-ci-image lint fmt fmt-check imports-check gosec gosec-json precommit prepush \
	migrate-create migrate-up migrate-down migrate-down-all migrate-version migrate-force \
	pg-start pg-stop pg-clean pg-init-schema pg-copy-from redis-start redis-stop redis-clean \
	gen-keys \
	signoz-start signoz-stop signoz-clean

