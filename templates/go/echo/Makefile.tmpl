	@echo "  low-cover        List files below coverage threshold"
	@echo "  test-integration Run integration tests"
	@echo "  cover-html       Generate HTML coverage report"
	@echo "  cover-func       Show coverage per function"
	@echo "  test-failed      Run tests and show failure traces"
	@echo "  test-fresh       Clear test cache"
	@echo "  test-clean       Run tests excluding query package"
	@echo "  cover-clean      Remove coverage output files"
