package repository

import (
	"context"

	"{{.ModuleName}}/pkg/db-sample/user"
)

func (r *repo) FindOne(ctx context.Context, f *user.Filter) (*user.Model, error) {
	var m user.Model
	q := r.db.WithContext(ctx).Model(&user.Model{})
	q = f.Apply(q)
	if err := q.Take(&m).Error; err != nil {
		return nil, err
	}
	return &m, nil
}

