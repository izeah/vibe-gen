package main

import (
	"fmt"
	"log"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/robfig/cron/v3"

	"{{.ModuleName}}/internal/config"
	"{{.ModuleName}}/internal/factory"
	sampleapp "{{.ModuleName}}/internal/app/sample"
	"{{.ModuleName}}/pkg/database"
)

func main() {
	// 1. Load config.
	cfg := config.Get()

	// 2. Initialize database.
	if err := database.Init(cfg); err != nil {
		fmt.Fprintf(os.Stderr, "database init failed: %v\n", err)
		os.Exit(1)
	}
	defer database.Close()

	// 3. Create factory (dependency wiring).
	f := factory.New(cfg)

	// 4. Create cron scheduler. A panicking job is recovered (logged) instead of killing the
	// process, and a slow run is never overlapped by its own next tick on this instance.
	logger := cron.VerbosePrintfLogger(log.New(os.Stdout, "cron: ", log.LstdFlags))
	c := cron.New(cron.WithSeconds(), cron.WithChain(cron.Recover(logger), cron.SkipIfStillRunning(logger)))

	// 5. Create application services and register cron entries.
	sampleSvc := sampleapp.NewServer(f)

	// Register cron jobs here, each under its distributed lock (see lock.go).
	// Example: run every minute; the lock TTL must exceed the job's worst-case duration.
	if _, err := c.AddFunc("0 * * * * *", locked("sample", 50*time.Second, sampleSvc.Run)); err != nil {
		fmt.Fprintf(os.Stderr, "invalid cron pattern: %v\n", err)
		os.Exit(1)
	}

	// 6. Start scheduler.
	c.Start()
	fmt.Printf("%s started\n", cfg.App.Name)

	// 7. Graceful shutdown.
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, os.Interrupt, syscall.SIGTERM)
	<-quit

	fmt.Println("shutting down...")
	ctx := c.Stop()
	<-ctx.Done()
	fmt.Println("stopped")
}
