package service

import (
	"context"
	"fmt"
)

// Run is the main entry point for the sample cron job.
func (s *service) Run(ctx context.Context) error {
	fmt.Println("[sample] cron job started")

	// Example: fetch active users from the sample bounded context.
	users, err := s.dbSampleRepo.User().Find(ctx, nil)
	if err != nil {
		return fmt.Errorf("fetching users: %w", err)
	}

	fmt.Printf("[sample] processed %d users\n", len(users))
	return nil
}
