PORT=3000
APP_NAME={{.ProjectSlug}}
LOG_LEVEL=debug

# Database — fill in your local values
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_SSLMODE=disable

# Redis — fill in your local values
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=

# Crypto — RSA keys for JWT signing (base64 or PEM path)
CRYPTO_PRIVATE_KEY="./secret/private.pem"
CRYPTO_PUBLIC_KEY="./secret/public.pem"
CRYPTO_ACCESS_TOKEN_LIFETIME=60
CRYPTO_REFRESH_TOKEN_LIFETIME=10080

# OpenTelemetry (optional)
OTEL_HOST_GRPC=

# Rate limiting
RATE_LIMIT=100
RATE_LIMIT_WINDOW_SEC=60

OTEL_EXPORTER_OTLP_ENDPOINT="localhost:4317"

