package ptr

// String returns a pointer to the passed string value.
func String(s string) *string {
	return &s
}

// Bool returns a pointer to the passed bool value.
func Bool(b bool) *bool {
	return &b
}

// Int returns a pointer to the passed int value.
func Int(i int) *int {
	return &i
}

// Int64 returns a pointer to the passed int64 value.
func Int64(i int64) *int64 {
	return &i
}

// Float64 returns a pointer to the passed float64 value.
func Float64(f float64) *float64 {
	return &f
}
