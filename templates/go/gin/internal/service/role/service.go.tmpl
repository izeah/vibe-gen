// Service manages roles and their permissions (route permission: roles:manage).
type Service interface {
	Find(ctx *abstraction.Context, f *dto.RoleFilter) ([]*dto.RoleResponse, *abstraction.PaginationInfo, error)
	FindByID(ctx *abstraction.Context, req *dto.RoleFindByIDRequest) (*dto.RoleResponse, error)
	Create(ctx *abstraction.Context, req *dto.RoleCreateRequest) (*dto.RoleResponse, error)
	Update(ctx *abstraction.Context, req *dto.RoleUpdateRequest) (*dto.RoleResponse, error)
	Delete(ctx *abstraction.Context, req *dto.RoleDeleteRequest) error
	SetPermissions(ctx *abstraction.Context, req *dto.RoleSetPermissionsRequest) (*dto.RoleResponse, error)
}

type service struct {
	roleRepository           repositoryrole.Repository
	rolePermissionRepository repositoryrolepermission.Repository
	userRoleRepository       repositoryuserrole.Repository
	authzService             serviceauthz.Service
	trxManager               *trxmanager.TrxManager
}

// New creates a new role Service.
func New(f *factory.Factory) Service {
	return &service{
		roleRepository:           f.RoleRepository,
		rolePermissionRepository: f.RolePermissionRepository,
		userRoleRepository:       f.UserRoleRepository,
		authzService:             serviceauthz.New(f),
		trxManager:               f.TrxManager,
	}
}

var roleCode = regexp.MustCompile(`^[a-z][a-z0-9_]{1,49}$`) // same rule as the roles.code CHECK

// checkPermissions rejects anything outside the catalog and returns the set without duplicates.
func (s *service) checkPermissions(perms []string) ([]string, error) {
	seen := make(map[string]bool, len(perms))
	out := make([]string, 0, len(perms))
	for _, p := range perms {
		if !authz.Valid(p) {
			return nil, response.ErrorConstant.BadRequest.WithMessage("unknown permission: " + p)
		}
		if !seen[p] {
			seen[p] = true
			out = append(out, p)
		}
	}
	return out, nil
}

func (s *service) toRoleResponse(m *model.Role, perms []string) *dto.RoleResponse {
	r := &dto.RoleResponse{
		ID:          m.ID.String(),
		Code:        m.Code,
		Name:        m.Name,
		Description: m.Description,
		IsSystem:    m.IsSystem,
		Permissions: perms,
		CreatedAt:   time.Unix(0, m.CreatedAt).UTC().Format(time.RFC3339),
	}
	if m.UpdatedAt != nil {
		r.UpdatedAt = time.Unix(0, *m.UpdatedAt).UTC().Format(time.RFC3339)
	}
	return r
}

// permissionsOf lists a role's permissions.
func (s *service) permissionsOf(ctx *abstraction.Context, roleID uuid.UUID) ([]string, error) {
	rows, err := s.rolePermissionRepository.Find(ctx, (&dto.RolePermissionFilter{RoleIDs: []string{roleID.String()}}).
		Order(abstraction.SortItem{Field: "permission", Order: "asc"}))
	if err != nil {
		return nil, err
	}
	perms := make([]string, len(rows))
	for i, row := range rows {
		perms[i] = row.Permission
	}
	return perms, nil
}
