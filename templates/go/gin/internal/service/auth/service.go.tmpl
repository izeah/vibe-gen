package serviceauth

import (
	"fmt"
	"net/http"
	"uuid"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/internal/factory"
	"{{.ModuleName}}/internal/model"
	redisrepo "{{.ModuleName}}/internal/repository/redis"
	repositoryuser "{{.ModuleName}}/internal/repository/user"
	authtoken "{{.ModuleName}}/pkg/auth-token"
	"{{.ModuleName}}/pkg/response"
)

// Service defines the authentication business logic contract.
type Service interface {
	Login(ctx *abstraction.Context, req *dto.LoginRequest) (*dto.LoginResponse, error)
	Refresh(ctx *abstraction.Context, req *dto.RefreshRequest) (*dto.LoginResponse, error)
	Logout(ctx *abstraction.Context, req *dto.RefreshRequest) error
}

type service struct {
	userRepository         repositoryuser.Repository
	refreshTokenRepository redisrepo.RefreshTokenRepository
	rateLimitRepository    redisrepo.RateLimitRepository
}

// New creates a new auth Service.
func New(f *factory.Factory) Service {
	return &service{
		userRepository:         f.UserRepository,
		refreshTokenRepository: f.RedisRepository.RefreshToken,
		rateLimitRepository:    f.RedisRepository.RateLimit,
	}
}

// issueTokens signs a new access/refresh pair. refreshJTI must already be registered
// as the current token of familyID (Save on login, Rotate on refresh).
func (s *service) issueTokens(user *model.User, familyID, refreshJTI string) (*dto.LoginResponse, error) {
	// Keys, issuer, issue time and lifetimes come from the config inside pkg/auth-token.
	token := authtoken.New(&authtoken.AddtionalClaims{
		TokenId:        uuid.NewV7().String(),
		RefreshTokenId: refreshJTI,
		FamilyId:       familyID,
		UserId:         user.ID.String(),
	})

	accessToken, err := token.AccessToken()
	if err != nil {
		return nil, response.ErrorBuilder(http.StatusInternalServerError, fmt.Errorf("generating access token: %w", err))
	}
	refreshToken, err := token.RefreshToken()
	if err != nil {
		return nil, response.ErrorBuilder(http.StatusInternalServerError, fmt.Errorf("generating refresh token: %w", err))
	}

	accessLifetime, _ := authtoken.Lifetimes()
	return &dto.LoginResponse{
		AccessToken:  accessToken,
		RefreshToken: refreshToken,
		ExpiresIn:    int(accessLifetime.Seconds()),
	}, nil
}

// verifyRefresh validates a refresh token (signature, expiry, iss/aud, typ=refresh).
func (s *service) verifyRefresh(token string) (*authtoken.CustomClaims, error) {
	claims, err := authtoken.ClaimsFromRefreshToken(token)
	if err != nil {
		return nil, response.ErrorConstant.Unauthorized.WithMessage("invalid refresh token")
	}
	return claims, nil
}
