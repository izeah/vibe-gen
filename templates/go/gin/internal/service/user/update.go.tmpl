package serviceuser

import (
	"net/http"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
)

func (s *service) Update(ctx *abstraction.Context, req *dto.UserUpdateRequest) (*dto.UserResponse, error) {
	m, err := s.userRepository.FindOne(ctx, (&dto.UserFilter{IDs: []string{req.ID}}).Scopes(s.withRoles))
	if err != nil {
		return nil, response.ErrorConstant.NotFound.WithMessage("user not found")
	}
	m.Context = ctx
	if req.Name != "" {
		m.Name = req.Name
	}
	if res := s.userRepository.Update(ctx, &dto.UserFilter{IDs: []string{req.ID}}, m); res.Error != nil {
		return nil, response.ErrorBuilder(http.StatusInternalServerError, res.Error)
	}
	return s.toUserResponse(m), nil
}
