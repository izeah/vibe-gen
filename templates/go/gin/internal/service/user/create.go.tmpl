package serviceuser

import (
	"errors"

	"github.com/jackc/pgx/v5/pgconn"
	"gorm.io/gorm"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/authz"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/internal/model"
	"{{.ModuleName}}/pkg/response"
)

// Create creates a user holding the default role (authz.DefaultRoleCode). Other roles are
// assigned through PUT /users/:id/roles, which needs roles:manage.
func (s *service) Create(ctx *abstraction.Context, req *dto.UserCreateRequest) (*dto.UserResponse, error) {
	hashed, err := model.HashPassword(req.Password)
	if err != nil {
		return nil, response.ErrorConstant.BadRequest.WithMessage(err.Error())
	}
	m := &model.User{
		Context:    ctx,
		UserEntity: model.UserEntity{Name: req.Name, Email: req.Email, Password: hashed},
	}
	// Errors inside the transaction are already response errors: the caller only passes them on.
	err = s.trxManager.WithTrx(ctx, func(ctx *abstraction.Context) error {
		var (
			err  error
			role *model.Role
		)
		if err = s.userRepository.Create(ctx, m).Error; err != nil {
			// users_email_lower_key: the database decides (no check-then-insert race).
			if pgErr := (*pgconn.PgError)(nil); errors.As(err, &pgErr) && pgErr.Code == "23505" {
				return response.ErrorConstant.Duplicate.WithMessage("email already registered")
			}
			return response.ErrorConstant.InternalServerError.WithError(err)
		}
		role, err = s.roleRepository.FindOne(ctx, &dto.RoleFilter{Codes: []string{authz.DefaultRoleCode}})
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil // default role deleted: the user starts without roles (no permissions)
		}
		if err != nil {
			return response.ErrorConstant.InternalServerError.WithError(err)
		}
		m.Roles = []*model.Role{role}
		if err = s.userRoleRepository.AssignRole(ctx, m.ID, role.ID).Error; err != nil {
			return response.ErrorConstant.InternalServerError.WithError(err)
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return s.toUserResponse(m), nil
}
