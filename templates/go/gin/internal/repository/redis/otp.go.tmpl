package redis

import (
	"context"
	"crypto/rand"
	"errors"
	"fmt"
	"math/big"
	"time"

	"github.com/redis/go-redis/v9"
	"golang.org/x/crypto/bcrypt"

	dtoredis "{{.ModuleName}}/internal/dto/redis"
)

var (
	ErrNotFound = errors.New("data not found")
)

const (
	RedisExpireOtpDefault   = 300 // 5 minutes
	RedisExpireTokenDefault = 3600 // 1 hour
	RedisKeyGenerateToken   = "session:token:%s"
)

// randomNumber returns a numeric OTP from crypto/rand (math/rand is predictable — never use it for secrets).
func randomNumber(length int) string {
	b := make([]byte, length)
	for i := range b {
		n, _ := rand.Int(rand.Reader, big.NewInt(10)) // crypto/rand never fails on supported platforms (Go 1.24+)
		b[i] = byte('0' + n.Int64())
	}
	return string(b)
}

type OtpRepository interface {
	CheckOtp(ctx context.Context, key string) error
	DeleteOtp(ctx context.Context, key string) error
	ValidateOTP(ctx context.Context, key, otp string) error
	GetOTP(ctx context.Context, key string, expire, lengthOtp int) (*dtoredis.OtpNumber, error)
	DeleteSessionToken(ctx context.Context, key string) error
	GenerateSessionToken(ctx context.Context, key string, expiresInSecond int) (*dtoredis.OtpToken, error)
}

type otp struct {
	client *redis.Client
}

func NewOtp(client *redis.Client) OtpRepository {
	return &otp{
		client: client,
	}
}

func (r *otp) CheckOtp(ctx context.Context, key string) error {
	storageData, err := r.client.Get(ctx, key).Result()
	if err != nil {
		if errors.Is(err, redis.Nil) {
			return ErrNotFound
		}
		return err
	}

	if storageData != "" {
		expiredIn, err := r.client.TTL(ctx, key).Result()
		if err != nil {
			return err
		}
		return fmt.Errorf("Otp already request. Will expire in %d second", int(expiredIn.Seconds()))
	}

	return nil
}

func (r *otp) DeleteOtp(ctx context.Context, key string) error {
	if _, err := r.client.Del(ctx, key).Result(); err != nil {
		return err
	}
	return nil
}

func (r *otp) ValidateOTP(ctx context.Context, key, otp string) error {
	o, err := r.client.Get(ctx, key).Result()
	if err != nil {
		if errors.Is(err, redis.Nil) {
			return ErrNotFound
		}
		return err
	}

	if err = bcrypt.CompareHashAndPassword([]byte(o), []byte(otp)); err != nil {
		return err
	}

	return nil
}

func (r *otp) GetOTP(ctx context.Context, key string, expire, lengthOtp int) (*dtoredis.OtpNumber, error) {
	otpStr := randomNumber(lengthOtp)
	hashedOTP, err := bcrypt.GenerateFromPassword([]byte(otpStr), bcrypt.MinCost)
	if err != nil {
		return nil, err
	}

	expiresInSecond := expire
	if expiresInSecond <= 0 {
		expiresInSecond = RedisExpireOtpDefault
	}

	_, err = r.client.SetEx(ctx, key, hashedOTP, time.Duration(expiresInSecond)*time.Second).Result()
	if err != nil {
		return nil, err
	}

	return &dtoredis.OtpNumber{
		Otp:       otpStr,
		ExpiresIn: expiresInSecond,
	}, nil
}

func (r *otp) DeleteSessionToken(ctx context.Context, key string) error {
	if _, err := r.client.Del(ctx, fmt.Sprintf(RedisKeyGenerateToken, key)).Result(); err != nil {
		return err
	}
	return nil
}

func (r *otp) GenerateSessionToken(ctx context.Context, key string, expiresInSecond int) (*dtoredis.OtpToken, error) {
	if expiresInSecond <= 0 {
		expiresInSecond = RedisExpireTokenDefault
	}

	otpToken := rand.Text() // 128+ bits of crypto/rand entropy
	hashedToken, err := bcrypt.GenerateFromPassword([]byte(otpToken), bcrypt.MinCost)
	if err != nil {
		return nil, err
	}

	_, err = r.client.SetEx(ctx, fmt.Sprintf(RedisKeyGenerateToken, key), hashedToken, time.Duration(expiresInSecond)*time.Second).Result()
	if err != nil {
		return nil, err
	}

	return &dtoredis.OtpToken{
		Token:     otpToken,
		ExpiresIn: expiresInSecond,
	}, nil
}
