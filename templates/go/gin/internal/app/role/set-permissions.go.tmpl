package role

import (
	"github.com/gin-gonic/gin"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
	"{{.ModuleName}}/pkg/validator"
)

// SetPermissions replaces the role's permission set.
// @Summary     Replace role permissions
// @Tags        role
// @Accept      json
// @Produce     json
// @Param       id    path  string                   true  "Role ID"
// @Param       body  body  dto.RoleSetPermissionsRequest  true  "Permission set (catalog values)"
// @Success     200   {object}  response.Base
// @Security    BearerAuth
// @Router      /v1/roles/{id}/permissions [put]
func (h *Handler) SetPermissions(c *gin.Context) {
	var (
		ctx     = abstraction.GetContext(c)
		payload = new(dto.RoleSetPermissionsRequest)
		data    *dto.RoleResponse
		err     error
	)
	if err = c.ShouldBindJSON(payload); err != nil {
		response.ErrorBadRequest(err).Send(c)
		return
	}
	if err = c.ShouldBindUri(payload); err != nil {
		response.ErrorBadRequest(err).Send(c)
		return
	}
	if err = validator.Struct(payload); err != nil {
		response.ErrorBadRequest(err).Send(c)
		return
	}
	if data, err = h.RoleService.SetPermissions(ctx, payload); err != nil {
		response.ErrorResponse(err).Send(c)
		return
	}
	response.SuccessResponse(data).Send(c)
}
