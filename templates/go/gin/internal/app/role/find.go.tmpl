package role

import (
	"github.com/gin-gonic/gin"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/internal/dto"
	"{{.ModuleName}}/pkg/response"
)

// Find lists roles with pagination.
// @Summary     List roles
// @Tags        role
// @Produce     json
// @Param       page       query  int  false  "Page number"
// @Param       page_size  query  int  false  "Items per page"
// @Success     200        {object}  response.Base
// @Security    BearerAuth
// @Router      /v1/roles [get]
func (h *Handler) Find(c *gin.Context) {
	var (
		ctx  = abstraction.GetContext(c)
		data []*dto.RoleResponse
		info *abstraction.PaginationInfo
		err  error
	)

	f := new(dto.RoleFilter)
	if err = c.ShouldBindQuery(f); err != nil {
		response.ErrorBadRequest(err).Send(c)
		return
	}

	f.Pagination = new(abstraction.Pagination)
	if err = c.ShouldBindQuery(f.Pagination); err != nil {
		response.ErrorBadRequest(err).Send(c)
		return
	}

	if data, info, err = h.RoleService.Find(ctx, f); err != nil {
		response.ErrorResponse(err).Send(c)
		return
	}
	response.SuccessListResponse(data, info).Send(c)
}
