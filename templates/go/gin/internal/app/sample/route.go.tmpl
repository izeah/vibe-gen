package sample

import (
	"github.com/gin-gonic/gin"

	"{{.ModuleName}}/internal/middleware"
)

// Route registers sample CRUD endpoints. Each needs a permission (roles/role_permissions);
// with an ":own" grant the service limits the action to the user's own samples.
func (h *Handler) Route(g *gin.RouterGroup) {
	can := func(action string) gin.HandlerFunc {
		return middleware.RequirePermission(h.AuthzService, "samples", action)
	}
	g.GET("", can("read"), h.Find)
	g.GET("/:id", can("read"), h.FindByID)
	g.POST("", can("create"), h.Create)
	g.PUT("/:id", can("update"), h.Update)
	g.DELETE("/:id", can("delete"), h.Delete)
}
