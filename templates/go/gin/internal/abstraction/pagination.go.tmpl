package abstraction

import (
	"math"
	"strings"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"
)

// SortItem defines a field and direction for multi-column or custom sorting.
type SortItem struct {
	Field string `query:"field" form:"field" json:"field" example:"created_at"`
	Order string `query:"order" form:"order" json:"order" example:"desc"` // asc, desc
}

// SortColumns is an ORDER BY allowlist: API sort field → trusted, qualified DB column.
// User-supplied sort fields never reach SQL directly; unknown fields are ignored.
type SortColumns map[string]string

// Apply adds an ORDER BY for every allowlisted item. Direction is DESC only for "desc".
func (c SortColumns) Apply(tx *gorm.DB, items ...SortItem) *gorm.DB {
	for _, s := range items {
		col, ok := c[s.Field]
		if !ok {
			continue
		}
		tx = tx.Order(clause.OrderByColumn{Column: clause.Column{Name: col}, Desc: strings.EqualFold(s.Order, "desc")})
	}
	return tx
}

type PaginationInfo struct {
	*Pagination
	Pages       int   `json:"pages"`
	Count       int64 `json:"count"`
	MoreRecords bool  `json:"more_records" example:"false"`
}

// Pagination ...
// swagger:params Pagination
type Pagination struct {
	// Page number of the results page to return.
	// Required: false
	// In: query
	Page *int `query:"page" form:"page" json:"page" example:"1"`

	// PageSize number of results to return per page.
	// Required: false
	// In: query
	PageSize *int `query:"page_size" form:"page_size" json:"page_size" example:"15"`

	// SortBy field to sort the results by.
	// Required: false
	// In: query
	SortBy *string `query:"sort_by" form:"sort_by" json:"sort_by,omitempty" example:"id"`

	// Sort direction to sort the results by.
	// Required: false
	// In: query
	// Enum: asc, desc
	Sort *string `query:"sort" form:"sort" json:"sort,omitempty" example:"desc"`

	lock bool
}

func (p *Pagination) SetPageInfo(count int64, lenData int) (info *PaginationInfo) {
	if p != nil && p.PageSize != nil {
		info = &PaginationInfo{
			Pagination:  p,
			MoreRecords: false,
			Count:       count,
			Pages:       int(math.Ceil(float64(count) / float64(*p.PageSize))),
		}
		if lenData >= *p.PageSize {
			info.MoreRecords = true
		}
	}
	return
}

// SortItems converts sort_by/sort query params into SortItems (default direction desc).
// Apply them through a SortColumns allowlist — never pass them to tx.Order directly.
func (p *Pagination) SortItems() []SortItem {
	if p == nil || p.SortBy == nil {
		return nil
	}
	order := "desc"
	if p.Sort != nil {
		order = *p.Sort
	}
	item := SortItem{Field: *p.SortBy, Order: order}
	return []SortItem{item}
}

func (p *Pagination) Init() {
	if p.lock {
		return
	}

	page := 1
	if p.Page != nil && *p.Page > 0 {
		page = *p.Page
	}

	pageSize := 0
	if p.PageSize != nil {
		pageSize = *p.PageSize
	}

	switch {
	case pageSize > 100:
		pageSize = 100
	case pageSize <= 0:
		pageSize = 10
	}

	p.Page = &page
	p.PageSize = &pageSize
	p.lock = true
}

func (p *Pagination) GetOffset() int {
	return (*p.Page - 1) * *p.PageSize
}

func (p *Pagination) GetLimit() int {
	return *p.PageSize + 1
}

// Apply always paginates (default page_size 10, max 100) so a list endpoint never
// returns an unbounded result set.
func (p *Pagination) Apply(db *gorm.DB) *gorm.DB {
	p.Init()
	db.Offset(p.GetOffset()).Limit(p.GetLimit())
	return db
}

