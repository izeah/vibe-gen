package middleware

import (
	"strings"
	"uuid"

	"github.com/gin-gonic/gin"
	authtoken "{{.ModuleName}}/pkg/auth-token"

	"{{.ModuleName}}/internal/abstraction"
	"{{.ModuleName}}/pkg/response"
)

// Authentication returns a Gin middleware that validates Bearer JWT tokens.
func Authentication() gin.HandlerFunc {
	return func(c *gin.Context) {
		authHeader := c.GetHeader("Authorization")
		if authHeader == "" || !strings.HasPrefix(authHeader, "Bearer ") {
			response.ErrorConstant.Unauthorized.Send(c)
			c.Abort()
			return
		}

		tokenStr := strings.TrimPrefix(authHeader, "Bearer ")
		claims, err := authtoken.ClaimsFromAccessToken(tokenStr)
		if err != nil {
			response.ErrorConstant.Unauthorized.WithMessage("invalid or expired token").Send(c)
			c.Abort()
			return
		}

		uidStr := claims.Subject
		var uid uuid.UUID
		if uidStr != "" {
			uid, _ = uuid.Parse(uidStr)
		}

		auth := &abstraction.AuthContext{
			ID:     uid,
			UserID: uidStr,
		}
		c.Set("auth", auth)
		// Audit columns (created_by/updated_by/deleted_by) read ctx.Auth.
		abstraction.GetContext(c).Auth = auth
		c.Next()
	}
}

