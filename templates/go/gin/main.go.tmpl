package main

import (
	"context"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/phuslu/log"

	"{{.ModuleName}}/internal/config"
	"{{.ModuleName}}/internal/delivery"
	"{{.ModuleName}}/internal/factory"
	"{{.ModuleName}}/internal/middleware"
	"{{.ModuleName}}/pkg/database"
	"{{.ModuleName}}/pkg/telemetry"
)

// maxBodyBytes caps every request body (JSON APIs need far less); raise it per route for uploads.
const maxBodyBytes = 1 << 20

func main() {
	cfg := config.Get()
	// Cookie mode guards refresh/logout with an Origin allowlist: without one every request fails.
	if cfg.App.AuthCookieMode && len(cfg.App.CorsAllowOrigin) == 0 {
		log.Fatal().Msg("auth_cookie_mode requires cors_allow_origin (the exact SPA origin)")
	}
	// A role change or a deleted user only takes effect when the access token expires.
	if cfg.Crypto.AccessTokenLifetime > 60 {
		log.Fatal().Msg("crypto.access_token_lifetime must be at most 60 minutes")
	}

	// 2. Initialize Telemetry (OpenTelemetry tracer/logger + phuslu/log bridge)
	teleCtx, teleCancel := context.WithCancel(context.Background())
	defer teleCancel()
	if _, err := telemetry.Init(teleCtx, cfg.App.Name, cfg.OpenTelemetry.HostGrpc, cfg.App.LogLevel); err != nil {
		log.Fatal().Err(err).Msg("failed to initialize telemetry")
	}
	defer func() {
		shutdownCtx, shutdownCancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer shutdownCancel()
		if err := telemetry.Shutdown(shutdownCtx); err != nil {
			log.Error().Err(err).Msg("telemetry shutdown error")
		}
	}()

	// 1. Initialize database.
	database.Init()
	defer database.Close()

	if cfg.App.LogLevel != "debug" {
		gin.SetMode(gin.ReleaseMode)
	}

	r := gin.New()
	// Only listed proxies may set X-Forwarded-For (gin trusts every proxy by default, which lets
	// any client spoof c.ClientIP() and dodge the per-IP login rate limit).
	if err := r.SetTrustedProxies(cfg.App.TrustedProxies); err != nil {
		log.Fatal().Err(err).Msg("invalid trusted_proxies")
	}
	r.Use(gin.Recovery())
	r.Use(middleware.SecureHeaders(cfg.App.BasePath))
	if len(cfg.App.CorsAllowOrigin) > 0 {
		r.Use(middleware.CORS(cfg.App.CorsAllowOrigin, cfg.App.AuthCookieMode))
	}
	r.Use(middleware.Trace())
	r.Use(middleware.Context())

	f := factory.NewFactory()
	delivery.HTTP(r, f)

	srv := &http.Server{
		Addr:              fmt.Sprintf(":%d", cfg.App.Port),
		Handler:           http.MaxBytesHandler(r, maxBodyBytes),
		ReadHeaderTimeout: 10 * time.Second, // Slowloris protection
	}

	go func() {
		log.Info().Msgf("starting %s on :%d", cfg.App.Name, cfg.App.Port)
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatal().Err(err).Msg("server error")
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, os.Interrupt, syscall.SIGTERM)
	<-quit

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := srv.Shutdown(ctx); err != nil {
		log.Error().Err(err).Msg("shutdown error")
	}
	log.Info().Msg("server stopped")
}
