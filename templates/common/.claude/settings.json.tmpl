{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PONYTAIL_DEFAULT_MODE": "full"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Read(**/.env.development.local)",
      "Edit(**/.env.development.local)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.production.local)",
      "Edit(**/.env.production.local)",
      "Read(**/.env.prod)",
      "Edit(**/.env.prod)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Read(**/.env.test.local)",
      "Edit(**/.env.test.local)",
      "Read(**/.env.docker)",
      "Edit(**/.env.docker)",
      "Read(**/config.yml)",
      "Edit(**/config.yml)",
      "Read(**/config.yaml)",
      "Edit(**/config.yaml)",
      "Read(**/config.local.yml)",
      "Edit(**/config.local.yml)",
      "Read(**/config.local.yaml)",
      "Edit(**/config.local.yaml)",
      "Read(**/config.dev.yml)",
      "Edit(**/config.dev.yml)",
      "Read(**/config.dev.yaml)",
      "Edit(**/config.dev.yaml)",
      "Read(**/config.development.yml)",
      "Edit(**/config.development.yml)",
      "Read(**/config.development.yaml)",
      "Edit(**/config.development.yaml)",
      "Read(**/config.staging.yml)",
      "Edit(**/config.staging.yml)",
      "Read(**/config.staging.yaml)",
      "Edit(**/config.staging.yaml)",
      "Read(**/config.prod.yml)",
      "Edit(**/config.prod.yml)",
      "Read(**/config.prod.yaml)",
      "Edit(**/config.prod.yaml)",
      "Read(**/config.production.yml)",
      "Edit(**/config.production.yml)",
      "Read(**/config.production.yaml)",
      "Edit(**/config.production.yaml)",
      "Read(**/config.test.yml)",
      "Edit(**/config.test.yml)",
      "Read(**/config.test.yaml)",
      "Edit(**/config.test.yaml)",
      "Read(./secret/**)",
      "Read(./secret-auth/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(psql *)",
      "Bash(pgcli *)",
      "Bash(mysql *)",
      "Bash(mariadb *)",
      "Bash(redis-cli *)",
      "Bash(mongosh *)",
      "Bash(docker exec * psql *)",
      "Bash(docker exec * mysql *)",
      "Bash(docker exec * mariadb *)",
      "Bash(docker exec * redis-cli *)",
      "Bash(docker compose exec * psql *)",
      "Bash(docker compose exec * mysql *)",
      "Bash(docker compose exec * redis-cli *)",
      "Bash(make pg-copy-from*)",
      "mcp__MCP_DOCKER",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)"
    ]
  }
}
