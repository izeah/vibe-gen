### Animation Tokens (Framer Motion)

```typescript
// src/lib/motion.ts — shared animation presets

export const spring = {
  /** Snappy UI transitions (button press, toggle) */
  snappy: { type: "spring", stiffness: 400, damping: 30 },
  /** Smooth page/modal transitions */
  smooth: { type: "spring", stiffness: 300, damping: 30 },
  /** Gentle entrance animations */
  gentle: { type: "spring", stiffness: 200, damping: 25 },
  /** Bouncy micro-interactions */
  bouncy: { type: "spring", stiffness: 500, damping: 25 },
} as const;

export const easing = {
  /** Standard ease-in-out */
  standard: [0.4, 0, 0.2, 1],
  /** Enter from outside */
  decelerate: [0, 0, 0.2, 1],
  /** Exit to outside */
  accelerate: [0.4, 0, 1, 1],
} as const;

export const duration = {
  instant: 0.1,
  fast: 0.15,
  normal: 0.2,
  moderate: 0.3,
  slow: 0.4,
  sluggish: 0.6,
} as const;

/** Fade + slide up — page/section entrance */
export const fadeInUp = {
  hidden: { opacity: 0, y: 16 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { ...spring.gentle },
  },
};

/** Fade in only — overlay/modal backdrop */
export const fadeIn = {
  hidden: { opacity: 0 },
  visible: { opacity: 1, transition: { duration: duration.normal } },
};

/** Scale in — dropdown, popover, tooltip */
export const scaleIn = {
  hidden: { opacity: 0, scale: 0.95 },
  visible: {
    opacity: 1,
    scale: 1,
    transition: { ...spring.snappy },
  },
};

/** Stagger container — animate list items sequentially */
export const staggerContainer = {
  hidden: {},
  visible: {
    transition: { staggerChildren: 0.06 },
  },
};

/** Stagger child item */
export const staggerItem = {
  hidden: { opacity: 0, y: 12 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { ...spring.gentle },
  },
};
```

