import { createMiddleware } from "hono/factory";
import { logger } from "../pkg/logger/logger.ts";
import type { Env } from "./env.ts";

// requestLog writes one line per request: no query string (filters may hold PII), no bodies.
export const requestLog = createMiddleware<Env>(async (c, next) => {
  const start = performance.now();
  await next();
  logger.info(
    {
      request_id: c.var.ctx.requestId,
      method: c.req.method,
      path: c.req.path,
      status: c.res.status,
      duration_ms: Math.round(performance.now() - start),
    },
    "request",
  );
});
