import { createMiddleware } from "hono/factory";
import { errors } from "../abstraction/error.ts";
import type { Factory } from "../factory/factory.ts";
import {
  type Claims,
  TYPE_ACCESS,
  verify,
} from "../pkg/auth-token/auth-token.ts";
import type { Env } from "./env.ts";

// authentication requires a valid access token (Bearer) and sets ctx.auth.
// Refresh tokens are rejected here (typ check).
export function authentication(f: Factory) {
  return createMiddleware<Env>(async (c, next) => {
    const header = c.req.header("authorization") ?? "";
    if (!header.startsWith("Bearer ")) throw errors.unauthorized();
    let claims: Claims;
    try {
      claims = await verify(
        header.slice("Bearer ".length),
        f.keys.publicKey,
        f.config.APP_NAME,
        TYPE_ACCESS,
      );
    } catch {
      throw errors.unauthorized("invalid or expired token");
    }
    c.var.ctx.auth = { id: claims.sub };
    await next();
  });
}
