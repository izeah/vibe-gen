import { errors } from "../../abstraction/error.ts";
import { success } from "../../abstraction/response.ts";
import type { C } from "../../middleware/env.ts";
import type { Handler } from "./handler.ts";

// GET /v1/users/me: the caller's own profile.
export const me =
  (h: Handler) =>
  async (c: C) => {
    const ctx = c.var.ctx;
    if (!ctx.auth) throw errors.unauthorized();
    return c.json(success(await h.userService.findById(ctx, ctx.auth.id)));
  };
