import { Hono } from "hono";
import type { Env } from "../../middleware/env.ts";
import { check } from "./check.ts";
import type { Handler } from "./handler.ts";

// Routes are relative: the group path is set in delivery/http.ts.
export function route(h: Handler): Hono<Env> {
  const r = new Hono<Env>();
  r.get("/", check(h));
  return r;
}
