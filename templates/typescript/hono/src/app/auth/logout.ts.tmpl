import { clear, guard, refreshTokenOf } from "../../abstraction/auth-cookie.ts";
import { success } from "../../abstraction/response.ts";
import type { C } from "../../middleware/env.ts";
import { body as readBody } from "../../middleware/error.ts";
import { cookieIO, type Handler } from "./handler.ts";

// POST /v1/auth/logout
export const logout = (h: Handler) => async (c: C) => {
  const io = cookieIO(c);
  guard(h.config, io);
  clear(h.config, io); // always drop the cookie, even if the token is invalid
  const body = await refreshTokenOf(h.config, io, () => readBody(c));
  await h.authService.logout(c.var.ctx, body);
  return c.json(success());
};
