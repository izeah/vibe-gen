import { created } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { roleCreateRequest } from "../../dto/role.ts";
import type { C } from "../../middleware/env.ts";
import { body as readBody } from "../../middleware/error.ts";
import type { Handler } from "./handler.ts";

// POST /v1/roles
export const create =
  (h: Handler) =>
  async (c: C) => {
    const body = parse(roleCreateRequest, await readBody(c));
    return c.json(created(await h.roleService.create(c.var.ctx, body)), 201);
  };
