import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { roleFindQuery } from "../../dto/role.ts";
import type { C } from "../../middleware/env.ts";
import type { Handler } from "./handler.ts";

// GET /v1/roles?page=&page_size=&sort_by=&sort=
export const find =
  (h: Handler) =>
  async (c: C) => {
    const query = parse(roleFindQuery, c.req.query());
    const { data, info } = await h.roleService.find(c.var.ctx, query);
    return c.json(success(data, info));
  };
