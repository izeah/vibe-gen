import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { roleIdParams } from "../../dto/role.ts";
import type { C } from "../../middleware/env.ts";
import type { Handler } from "./handler.ts";

// GET /v1/roles/:id
export const findById =
  (h: Handler) =>
  async (c: C) => {
    const { id } = parse(roleIdParams, c.req.param());
    return c.json(success(await h.roleService.findById(c.var.ctx, id)));
  };
