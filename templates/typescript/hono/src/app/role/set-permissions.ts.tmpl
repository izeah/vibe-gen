import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { roleIdParams, roleSetPermissionsRequest } from "../../dto/role.ts";
import type { C } from "../../middleware/env.ts";
import { body as readBody } from "../../middleware/error.ts";
import type { Handler } from "./handler.ts";

// PUT /v1/roles/:id/permissions (replaces the whole set)
export const setPermissions =
  (h: Handler) =>
  async (c: C) => {
    const { id } = parse(roleIdParams, c.req.param());
    const body = parse(roleSetPermissionsRequest, await readBody(c));
    return c.json(success(await h.roleService.setPermissions(c.var.ctx, id, body)));
  };
