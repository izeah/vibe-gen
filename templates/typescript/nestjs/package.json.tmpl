{
  "name": "{{.ProjectSlug}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && (tsc --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js)",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "5.33.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "scarfSettings": {
    "enabled": false
  }
}
