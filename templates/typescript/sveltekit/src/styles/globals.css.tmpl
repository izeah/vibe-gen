/* Neutral scaffold: replace the tokens with the project's design direction (DESIGN.md, docs/design_system.md). */
:root {
  --bg: #fafafa;
  --fg: #18181b;
  --muted: #52525b;
  --border: #85858f;
  --accent: #1d4ed8;
  --accent-fg: #ffffff;
  --danger: #b91c1c;
  --radius: 8px;
  --font-sans: system-ui, sans-serif;
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-xl: 1.5rem;
  color-scheme: light;
}

/* An explicit choice (the toggle, data-theme on <html>) wins; without one the OS preference decides.
   ponytail: the dark values are written twice. light-dark() would keep one list, at the cost of
   browsers older than Chrome 123 / Firefox 120 / Safari 17.5. */
:root[data-theme="dark"] {
  --bg: #18181b;
  --fg: #f4f4f5;
  --muted: #a1a1aa;
  --border: #6e6e78;
  --accent: #93c5fd;
  --accent-fg: #18181b;
  --danger: #fca5a5;
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme]) {
    --bg: #18181b;
    --fg: #f4f4f5;
    --muted: #a1a1aa;
    --border: #6e6e78;
    --accent: #93c5fd;
    --accent-fg: #18181b;
    --danger: #fca5a5;
    color-scheme: dark;
  }
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100dvh;
  display: grid;
  place-items: center;
  padding: var(--space-4);
  background: var(--bg);
  color: var(--fg);
  font: var(--text-base) / 1.5 var(--font-sans);
}

.card {
  width: min(100%, 24rem);
  padding: var(--space-6);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.stack > * + * {
  margin-top: var(--space-4);
}

h1 {
  margin: 0;
  font-size: var(--text-xl);
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

a {
  color: var(--accent);
}

.field {
  display: grid;
  gap: var(--space-1);
}

input,
button {
  font: inherit;
  min-height: 2.75rem;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius);
  border: 1px solid var(--border);
}

input {
  background: transparent;
  color: inherit;
}

button {
  width: 100%;
  background: var(--accent);
  color: var(--accent-fg);
  border-color: var(--accent);
  cursor: pointer;
}

button:disabled {
  opacity: 0.6;
  cursor: progress;
}

:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

.error {
  color: var(--danger);
  min-height: 1.5em;
  margin: 0;
}

.profile {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--space-1) var(--space-4);
}

.profile dt {
  color: var(--muted);
}

.profile dd {
  margin: 0;
}

/* ThemeToggle: top right of the page, filled while dark mode is on. */
.theme-toggle {
  position: absolute;
  inset: var(--space-4) var(--space-4) auto auto;
  width: auto;
  background: transparent;
  color: var(--fg);
  border-color: var(--border);
}

.theme-toggle[aria-pressed="true"] {
  background: var(--fg);
  color: var(--bg);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms;
    animation-iteration-count: 1;
    transition-duration: 0.01ms;
    scroll-behavior: auto;
  }
}

/* SvelteKit mount point: no layout box of its own (a class, because the CSP forbids inline styles). */
.app {
  display: contents;
}
