import { proxy } from "../../src/server/bff/handlers.ts";

// Everything else under /api goes to the backend API (allowlisted prefixes only; the
// API's /v1/auth/* is blocked). The raw, still-encoded path is used, never decoded params.
export default defineEventHandler((event) => {
  const req = toWebRequest(event);
  return proxy(req, new URL(req.url).pathname.slice("/api".length));
});
