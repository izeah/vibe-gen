# Copy to .env.local (git-ignored). Server-only: never prefix these with NEXT_PUBLIC_.
# Backend API (Go or Node templates, AUTH_COOKIE_MODE=false). Prefix allowed: https://example.com/api-go
API_BASE_URL=http://localhost:3000
# Public origin of this app (Origin check for state-changing requests).
APP_ORIGIN=http://localhost:3001
# 32+ random characters, e.g. `openssl rand -base64 32`. Rotating it signs everyone out.
BFF_COOKIE_SECRET=dummy-change-me-dummy-change-me-dummy
# Path prefixes /api may proxy to (comma-separated). /v1/auth/* is always blocked.
BFF_PROXY_PREFIXES=/v1/
# Reverse proxies in front of this app that append to X-Forwarded-For (0 = none: the header is
# client-controlled and is not forwarded to the API).
BFF_TRUSTED_PROXY_HOPS=0
BFF_TIMEOUT_MS=10000
BFF_MAX_BODY_BYTES=1048576
