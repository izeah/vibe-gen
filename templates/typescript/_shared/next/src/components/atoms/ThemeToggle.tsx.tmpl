"use client";

import { useEffect, useState } from "react";
import { currentTheme, setTheme } from "../../lib/theme-client.ts";

// One labelled button; the state lives in aria-pressed. The server cannot know the OS preference,
// so the state is read after mount (the colors never wait: data-theme/CSS decide them).
export function ThemeToggle() {
  const [dark, setDark] = useState(false);

  useEffect(() => {
    setDark(currentTheme() === "dark");
  }, []);

  function toggle() {
    const next = dark ? "light" : "dark";
    setTheme(next);
    setDark(next === "dark");
  }

  return (
    <button
      type="button"
      className="theme-toggle"
      aria-pressed={dark}
      onClick={toggle}
    >
      Dark mode
    </button>
  );
}
