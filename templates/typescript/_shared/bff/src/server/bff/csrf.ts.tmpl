import { timingSafeEqual } from "node:crypto";
import type { BffConfig } from "./config.ts";
import { CSRF, parseCookies } from "./cookies.ts";

export const CSRF_HEADER = "x-csrf-token";

const SAFE = new Set(["GET", "HEAD", "OPTIONS"]);

// checkCsrf guards every state-changing request: the Origin (or Sec-Fetch-Site) must be this
// app, and the X-CSRF-Token header must equal the __Host-csrf cookie (double submit).
export function checkCsrf(cfg: BffConfig, req: Request): boolean {
  if (SAFE.has(req.method)) return true;
  const origin = req.headers.get("origin");
  const site = req.headers.get("sec-fetch-site");
  const sameOrigin = origin ? origin === cfg.APP_ORIGIN : site === "same-origin";
  if (!sameOrigin) return false;
  const cookie = parseCookies(req.headers.get("cookie")).get(CSRF) ?? "";
  const header = req.headers.get(CSRF_HEADER) ?? "";
  const a = Buffer.from(cookie);
  const b = Buffer.from(header);
  return a.length > 0 && a.length === b.length && timingSafeEqual(a, b);
}
