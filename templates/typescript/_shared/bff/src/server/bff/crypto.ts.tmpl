import {
  createCipheriv,
  createDecipheriv,
  createHash,
  randomBytes,
} from "node:crypto";

// AES-256-GCM sealing for cookie values. The cookie name is bound as additional data, so a
// value cannot be moved from one cookie to another. Output: base64url(iv | tag | ciphertext).
const key = (secret: string): Buffer =>
  createHash("sha256").update(secret).digest();

export function seal(secret: string, name: string, plain: string): string {
  const iv = randomBytes(12);
  const cipher = createCipheriv("aes-256-gcm", key(secret), iv);
  cipher.setAAD(Buffer.from(name));
  const body = Buffer.concat([cipher.update(plain, "utf8"), cipher.final()]);
  return Buffer.concat([iv, cipher.getAuthTag(), body]).toString("base64url");
}

// open returns undefined for anything tampered, truncated or sealed with another secret/name.
export function open(
  secret: string,
  name: string,
  sealed: string,
): string | undefined {
  try {
    const raw = Buffer.from(sealed, "base64url");
    if (raw.length < 29) return undefined;
    const decipher = createDecipheriv(
      "aes-256-gcm",
      key(secret),
      raw.subarray(0, 12),
      { authTagLength: 16 }, // reject short tags outright, never rely on the slice length alone
    );
    decipher.setAAD(Buffer.from(name));
    decipher.setAuthTag(raw.subarray(12, 28));
    return Buffer.concat([
      decipher.update(raw.subarray(28)),
      decipher.final(),
    ]).toString("utf8");
  } catch {
    return undefined;
  }
}
