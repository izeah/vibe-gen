import type { Context } from "../../abstraction/context.ts";
import { errors } from "../../abstraction/error.ts";
import {
  type RoleResponse,
  type RoleSetPermissionsRequest,
  toRoleResponse,
} from "../../dto/role.ts";
import { checkPermissions, type Deps } from "./service.ts";

// setPermissions replaces the role's whole permission set in one transaction and drops the
// cached set, so the change applies to the next request.
export async function setPermissions(
  d: Deps,
  ctx: Context,
  id: string,
  req: RoleSetPermissionsRequest,
): Promise<RoleResponse> {
  const perms = checkPermissions(req.permissions);
  const role = await d.trxManager.withTrx(ctx, async (tx) => {
    // Lock the role row: concurrent replacements of the same set run one after the other.
    const r = await d.roleRepository.findOne(tx, { ids: [id], forUpdate: true });
    if (!r) throw errors.notFound("role not found");
    if (r.isSystem) throw errors.forbidden("system roles cannot be changed");
    await d.rolePermissionRepository.syncPermissions(tx, id, perms);
    return r;
  });
  await d.authzService.invalidateRoles(id);
  return toRoleResponse(role, perms);
}
