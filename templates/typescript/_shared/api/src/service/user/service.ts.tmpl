import type { Context } from "../../abstraction/context.ts";
import type {
  UserCreateRequest,
  UserResponse,
  UserSetRolesRequest,
  UserUpdateRequest,
} from "../../dto/user.ts";
import type { Factory } from "../../factory/factory.ts";
import type { Role } from "../../model/role.ts";
import { type AuthzService, newAuthzService } from "../authz/service.ts";
import { create } from "./create.ts";
import { findById } from "./find-by-id.ts";
import { setRoles } from "./set-roles.ts";
import { update } from "./update.ts";

export type UserService = {
  findById(ctx: Context, id: string): Promise<UserResponse>;
  create(ctx: Context, req: UserCreateRequest): Promise<UserResponse>;
  update(
    ctx: Context,
    id: string,
    req: UserUpdateRequest,
  ): Promise<UserResponse>;
  setRoles(ctx: Context, id: string, req: UserSetRolesRequest): Promise<UserResponse>;
};

export type Deps = Pick<
  Factory,
  "userRepository" | "roleRepository" | "userRoleRepository" | "trxManager"
> & { authzService: AuthzService };

export function newUserService(f: Factory): UserService {
  const d: Deps = {
    userRepository: f.userRepository,
    roleRepository: f.roleRepository,
    userRoleRepository: f.userRoleRepository,
    trxManager: f.trxManager,
    authzService: newAuthzService(f),
  };
  return {
    findById: (ctx, id) => findById(d, ctx, id),
    create: (ctx, req) => create(d, ctx, req),
    update: (ctx, id, req) => update(d, ctx, id, req),
    setRoles: (ctx, id, req) => setRoles(d, ctx, id, req),
  };
}

// rolesOf lists the roles a user holds, ordered by code (two queries, never one per role).
export async function rolesOf(d: Deps, ctx: Context, userId: string): Promise<Role[]> {
  const ids = (await d.userRoleRepository.find(ctx, { userIds: [userId] })).map((r) => r.roleId);
  if (ids.length === 0) return [];
  return d.roleRepository.find(ctx, { ids, sorts: [{ field: "code", order: "asc" }] });
}
