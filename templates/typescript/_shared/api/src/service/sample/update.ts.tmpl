import { type Context, ownerId } from "../../abstraction/context.ts";
import { errors } from "../../abstraction/error.ts";
import {
  type SampleResponse,
  type SampleUpdateRequest,
  toSampleResponse,
} from "../../dto/sample.ts";
import type { Deps } from "./service.ts";

export async function update(
  d: Deps,
  ctx: Context,
  id: string,
  req: SampleUpdateRequest,
): Promise<SampleResponse> {
  // Rows of other users are "not found" (no existence leak) when the permission is "own".
  const changed = await d.sampleRepository.updates(
    ctx,
    { ids: [id], createdBy: ownerId(ctx) },
    req,
  );
  if (changed === 0) throw errors.notFound("sample not found");
  const sample = await d.sampleRepository.findOne(ctx, { ids: [id] });
  if (!sample) throw errors.notFound("sample not found");
  return toSampleResponse(sample);
}
