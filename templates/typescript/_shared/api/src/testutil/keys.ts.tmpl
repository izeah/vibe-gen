import { generateKeyPairSync } from "node:crypto";
import type { Keys } from "../pkg/auth-token/auth-token.ts";

// testKeys returns a throwaway RSA key pair for tests (never the real ./secret-auth keys).
export function testKeys(): Keys {
  const { privateKey, publicKey } = generateKeyPairSync("rsa", {
    modulusLength: 2048,
  });
  return { privateKey, publicKey };
}
