import { applyFilter } from "../../abstraction/pagination.ts";
import { type Context, conn } from "../../abstraction/context.ts";
import {
  type UserFilter,
  userSortColumns,
  userWhere,
} from "../../dto/user.ts";
import { type User, users } from "../../model/user.ts";

export function find(ctx: Context, f: UserFilter = {}): Promise<User[]> {
  const q = conn(ctx).select().from(users).where(userWhere(f)).$dynamic();
  return applyFilter(q, f, userSortColumns);
}
