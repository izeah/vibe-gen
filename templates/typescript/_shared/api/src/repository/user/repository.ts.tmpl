import { count } from "./count.ts";
import { create } from "./create.ts";
import { deleteRows } from "./delete.ts";
import { exists } from "./exists.ts";
import { find } from "./find.ts";
import { findOne } from "./find-one.ts";
import { firstOrCreate } from "./first-or-create.ts";
import { ids } from "./ids.ts";
import { softDelete } from "./soft-delete.ts";
import { update } from "./update.ts";
import { updateOrInsert } from "./update-or-insert.ts";
import { updates } from "./updates.ts";

// The 12 standard repository methods (one file each). They are a deliberate, ready-to-use
// API: keep them even when unused, and do not expose them as endpoints just to "use" them.
export const userRepository = {
  find,
  findOne,
  count,
  create,
  update,
  updates,
  updateOrInsert,
  softDelete,
  firstOrCreate,
  exists,
  delete: deleteRows,
  ids,
};

export type UserRepository = typeof userRepository;
