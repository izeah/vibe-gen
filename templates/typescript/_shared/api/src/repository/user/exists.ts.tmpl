import { sql } from "drizzle-orm";
import { type Context, conn } from "../../abstraction/context.ts";
import { type UserFilter, userWhere } from "../../dto/user.ts";
import { users } from "../../model/user.ts";

export async function exists(ctx: Context, f: UserFilter): Promise<boolean> {
  const rows = await conn(ctx)
    .select({ one: sql`1` })
    .from(users)
    .where(userWhere(f))
    .limit(1);
  return rows.length > 0;
}
