import type { Context } from "../../abstraction/context.ts";
import type { UserFilter } from "../../dto/user.ts";
import type { NewUser, User } from "../../model/user.ts";
import { create } from "./create.ts";
import { findOne } from "./find-one.ts";

// firstOrCreate returns the first row matching f, or inserts data. A unique constraint must
// back f when callers can race (concurrent inserts then fail instead of duplicating).
export async function firstOrCreate(
  ctx: Context,
  f: UserFilter,
  data: NewUser,
): Promise<User> {
  const found = await findOne(ctx, f);
  if (found) return found;
  const [row] = await create(ctx, data);
  if (!row) throw new Error("firstOrCreate: insert returned no row");
  return row;
}
