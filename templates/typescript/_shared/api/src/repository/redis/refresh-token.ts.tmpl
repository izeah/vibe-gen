import type { Redis } from "../../pkg/redis/redis.ts";

// One valid refresh token (jti) per session family. Rotating swaps it atomically;
// presenting an older jti means the token was stolen or replayed, so the family is revoked.
export type RotateResult = "rotated" | "missing" | "reuse";

export type RefreshTokenRepository = {
  // save starts a family (login) with its first refresh jti.
  save(familyId: string, jti: string, ttlMs: number): Promise<void>;
  // rotate swaps jti for newJti: "missing" if the family is unknown/expired/revoked,
  // "reuse" (family deleted) if jti is not the current one.
  rotate(
    familyId: string,
    jti: string,
    newJti: string,
    ttlMs: number,
  ): Promise<RotateResult>;
  // revoke ends the family (logout).
  revoke(familyId: string): Promise<void>;
};

const KEY = "auth:refresh:family:";

// 1 = rotated, 0 = family missing, -1 = reuse (family deleted). Same script as the Go templates.
const ROTATE = `
local cur = redis.call('GET', KEYS[1])
if not cur then return 0 end
if cur ~= ARGV[1] then redis.call('DEL', KEYS[1]) return -1 end
redis.call('SET', KEYS[1], ARGV[2], 'PX', ARGV[3])
return 1
`;

// ponytail: two tabs refreshing at the same instant look like reuse and log the user out;
// the BFF must serialize refreshes per session. Add a short grace window if that bites.
export const newRefreshTokenRepository = (
  redis: Redis,
): RefreshTokenRepository => ({
  async save(familyId, jti, ttlMs) {
    await redis.set(KEY + familyId, jti, {
      expiration: { type: "PX", value: ttlMs },
    });
  },
  async rotate(familyId, jti, newJti, ttlMs) {
    const res = await redis.eval(ROTATE, {
      keys: [KEY + familyId],
      arguments: [jti, newJti, String(ttlMs)],
    });
    if (res === 1) return "rotated";
    return res === -1 ? "reuse" : "missing";
  },
  async revoke(familyId) {
    await redis.del(KEY + familyId);
  },
});
