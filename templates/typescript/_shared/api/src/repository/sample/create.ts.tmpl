import { type Context, conn } from "../../abstraction/context.ts";
import {
  beforeCreate,
  type NewSample,
  type Sample,
  samples,
} from "../../model/sample.ts";

// create inserts one or many rows (one statement) and returns them with their ids.
export async function create(
  ctx: Context,
  e: NewSample | NewSample[],
): Promise<Sample[]> {
  const rows = await Promise.all(
    (Array.isArray(e) ? e : [e]).map((r) => beforeCreate(ctx, r)),
  );
  return conn(ctx).insert(samples).values(rows).returning();
}
