import { sql } from "drizzle-orm";
import { type Context, conn } from "../../abstraction/context.ts";
import { type SampleFilter, sampleWhere } from "../../dto/sample.ts";
import { samples } from "../../model/sample.ts";

export async function exists(ctx: Context, f: SampleFilter): Promise<boolean> {
  const rows = await conn(ctx)
    .select({ one: sql`1` })
    .from(samples)
    .where(sampleWhere(f))
    .limit(1);
  return rows.length > 0;
}
