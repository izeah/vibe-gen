import { type Context, conn } from "../../abstraction/context.ts";
import { type RolePermissionFilter, rolePermissionWhere } from "../../dto/role.ts";
import { rolePermissions } from "../../model/role-permission.ts";

// deleteRows hard-deletes the matching rows (soft-deleted rows only with withDeleted: true).
// Prefer softDelete; never expose this through an endpoint unless a feature needs it.
export async function deleteRows(ctx: Context, f: RolePermissionFilter): Promise<number> {
  const res = await conn(ctx).delete(rolePermissions).where(rolePermissionWhere(f));
  return res.rowCount ?? 0;
}
