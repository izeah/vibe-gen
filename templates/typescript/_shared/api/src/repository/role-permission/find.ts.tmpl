import { applyFilter } from "../../abstraction/pagination.ts";
import { type Context, conn } from "../../abstraction/context.ts";
import {
  type RolePermissionFilter,
  rolePermissionSortColumns,
  rolePermissionWhere,
} from "../../dto/role.ts";
import { type RolePermission, rolePermissions } from "../../model/role-permission.ts";

export function find(ctx: Context, f: RolePermissionFilter = {}): Promise<RolePermission[]> {
  const q = conn(ctx).select().from(rolePermissions).where(rolePermissionWhere(f)).$dynamic();
  return applyFilter(q, f, rolePermissionSortColumns);
}
