import { type Context, conn } from "../../abstraction/context.ts";
import {
  beforeCreate,
  type NewRolePermission,
  type RolePermission,
  rolePermissions,
} from "../../model/role-permission.ts";

// create inserts one or many rows (one statement) and returns them with their ids.
export async function create(
  ctx: Context,
  e: NewRolePermission | NewRolePermission[],
): Promise<RolePermission[]> {
  const rows = await Promise.all(
    (Array.isArray(e) ? e : [e]).map((r) => beforeCreate(ctx, r)),
  );
  return conn(ctx).insert(rolePermissions).values(rows).returning();
}
