import { type Context, conn } from "../../abstraction/context.ts";
import { beforeCreate, rolePermissions } from "../../model/role-permission.ts";

// givePermissionTo grants the permissions to the role in one insert; permissions the role
// already holds are kept. Callers validate them against the catalog first. Returns the number
// added.
export async function givePermissionTo(
  ctx: Context,
  roleId: string,
  ...perms: string[]
): Promise<number> {
  if (perms.length === 0) return 0;
  const res = await conn(ctx)
    .insert(rolePermissions)
    .values(perms.map((permission) => beforeCreate(ctx, { roleId, permission })))
    .onConflictDoNothing({ target: [rolePermissions.roleId, rolePermissions.permission] });
  return res.rowCount ?? 0;
}
