import { applyFilter } from "../../abstraction/pagination.ts";
import { type Context, conn } from "../../abstraction/context.ts";
import {
  type RoleFilter,
  roleSortColumns,
  roleWhere,
} from "../../dto/role.ts";
import { type Role, roles } from "../../model/role.ts";

export function find(ctx: Context, f: RoleFilter = {}): Promise<Role[]> {
  const q = conn(ctx).select().from(roles).where(roleWhere(f)).$dynamic();
  return applyFilter(q, f, roleSortColumns);
}
