// The 12 standard repository methods (one file each), plus the role assignment methods
// (hasRole, assignRole, revokeRole, reassignRole). They are a deliberate, ready-to-use API:
// keep them even when unused, and do not expose them as endpoints just to "use" them.
export const userRoleRepository = {
  find,
  findOne,
  count,
  create,
  update,
  updates,
  updateOrInsert,
  softDelete,
  firstOrCreate,
  exists,
  delete: deleteRows,
  ids,
  hasRole,
  assignRole,
  revokeRole,
  reassignRole,
};

export type UserRoleRepository = typeof userRoleRepository;
