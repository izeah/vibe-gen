import { type Context, conn } from "../../abstraction/context.ts";
import { type UserRoleFilter, userRoleWhere } from "../../dto/user-role.ts";
import { userRoles } from "../../model/user-role.ts";

// deleteRows hard-deletes the matching rows (soft-deleted rows only with withDeleted: true).
// Prefer softDelete; never expose this through an endpoint unless a feature needs it.
export async function deleteRows(ctx: Context, f: UserRoleFilter): Promise<number> {
  const res = await conn(ctx).delete(userRoles).where(userRoleWhere(f));
  return res.rowCount ?? 0;
}
