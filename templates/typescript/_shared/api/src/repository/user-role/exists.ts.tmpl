import { sql } from "drizzle-orm";
import { type Context, conn } from "../../abstraction/context.ts";
import { type UserRoleFilter, userRoleWhere } from "../../dto/user-role.ts";
import { userRoles } from "../../model/user-role.ts";

export async function exists(ctx: Context, f: UserRoleFilter): Promise<boolean> {
  const rows = await conn(ctx)
    .select({ one: sql`1` })
    .from(userRoles)
    .where(userRoleWhere(f))
    .limit(1);
  return rows.length > 0;
}
