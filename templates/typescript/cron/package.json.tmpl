{
  "name": "{{.ProjectSlug}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "run-job": "node --env-file-if-exists=.env src/cli/run-job.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "croner": "10.0.1",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "redis": "6.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
