import { Cron } from "croner";
import { config } from "../config/config.ts";
import { randomUUID } from "node:crypto";
import { type Logger, logger } from "../config/logger.ts";
import { redis } from "../config/redis.ts";
import * as sampleReportJob from "../jobs/sampleReportJob.ts";
import { withLock } from "../utils/lock.ts";

type Job = { JOB_NAME: string; run(log: Logger): Promise<unknown> };

type Entry = {
  job: Job;
  pattern: string; // croner syntax; 6 fields = with seconds
  lockTtlMs: number; // longer than the job's worst-case duration
};

// Register every job here, explicitly.
export const schedule: Entry[] = [
  { job: sampleReportJob, pattern: "0 */5 * * * *", lockTtlMs: 5 * 60_000 },
];

export const getAvailableJobs = (): string[] =>
  schedule.map((e) => e.job.JOB_NAME);

export const findJob = (name: string): Entry | undefined =>
  schedule.find((e) => e.job.JOB_NAME === name);

// execute runs one job under its distributed lock, with a run-scoped logger and timing.
// Errors are logged and rethrown (the scheduler swallows them; the CLI exits 1).
export async function execute(entry: Entry): Promise<unknown> {
  const runId = randomUUID();
  const log = logger.child({ job: entry.job.JOB_NAME, run_id: runId });
  const start = performance.now();
  try {
    const res = await withLock(redis, entry.job.JOB_NAME, runId, entry.lockTtlMs, () =>
      entry.job.run(log),
    );
    const duration_ms = Math.round(performance.now() - start);
    if (!res.ran) {
      log.info({ action: "skipped_locked" }, "already running on another instance");
      return undefined;
    }
    log.info({ action: "done", duration_ms }, "job finished");
    return res.result;
  } catch (err) {
    log.error({ action: "failed", err }, "job failed");
    throw err;
  }
}

// Runs in progress, so shutdown can wait for them before closing the DB and Redis.
const running = new Set<Promise<unknown>>();

// startScheduler registers every entry. An invalid pattern throws here, at startup.
// protect: a slow run is never overlapped by its next tick on the same instance.
export function startScheduler(): Cron[] {
  return schedule.map(
    (entry) =>
      new Cron(
        entry.pattern,
        {
          name: entry.job.JOB_NAME,
          timezone: config.CRON_TIMEZONE,
          protect: true,
          catch: () => {}, // already logged by execute
        },
        async () => {
          const run = execute(entry);
          running.add(run);
          try {
            await run;
          } finally {
            running.delete(run);
          }
        },
      ),
  );
}

// stopScheduler stops new ticks and waits for the runs in progress (their errors are logged).
export async function stopScheduler(crons: Cron[]): Promise<void> {
  for (const c of crons) c.stop();
  await Promise.allSettled(running);
  logger.info({ jobs: crons.length }, "scheduler stopped");
}
