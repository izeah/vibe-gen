# Copy to .env (git-ignored) and fill in real values. Never commit .env.
APP_NAME={{.ProjectSlug}}
APP_ENV=local
LOG_LEVEL=info
# Timezone used to evaluate cron expressions.
CRON_TIMEZONE=UTC
# false = start without scheduling (jobs can still run with `make run-job JOB=<name>`).
CRON_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres
DB_SSLMODE=disable

REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false
