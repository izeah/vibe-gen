import type { RequestHandler } from "express";
import { deliver, guard } from "../../abstraction/auth-cookie.ts";
import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { loginRequest } from "../../dto/auth.ts";
import { ctxOf } from "../../middleware/context.ts";
import { cookieIO } from "../../middleware/cookie-io.ts";
import type { Handler } from "./handler.ts";

// POST /v1/auth/login
export const login =
  (h: Handler): RequestHandler =>
  async (req, res) => {
    const io = cookieIO(req, res);
    guard(h.config, io);
    const body = parse(loginRequest, req.body);
    const tokens = await h.authService.login(ctxOf(res), body);
    res.json(success(deliver(h.config, io, tokens)));
  };
