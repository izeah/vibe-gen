import type { RequestHandler } from "express";
import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { sampleFindQuery } from "../../dto/sample.ts";
import { ctxOf } from "../../middleware/context.ts";
import type { Handler } from "./handler.ts";

// GET /v1/samples?page=&page_size=&sort_by=&sort=&name=&status=
export const find =
  (h: Handler): RequestHandler =>
  async (req, res) => {
    const query = parse(sampleFindQuery, req.query);
    const { data, info } = await h.sampleService.find(ctxOf(res), query);
    res.json(success(data, info));
  };
