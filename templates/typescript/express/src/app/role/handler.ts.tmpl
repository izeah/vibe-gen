import type { Factory } from "../../factory/factory.ts";
import { type AuthzService, newAuthzService } from "../../service/authz/service.ts";
import { newRoleService, type RoleService } from "../../service/role/service.ts";

export type Handler = { roleService: RoleService; authzService: AuthzService };

export const newHandler = (f: Factory): Handler => ({
  roleService: newRoleService(f),
  authzService: newAuthzService(f),
});
