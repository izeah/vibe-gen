import { Router } from "express";
import { requirePermission } from "../../middleware/permission.ts";
import { create } from "./create.ts";
import { remove } from "./delete.ts";
import { find } from "./find.ts";
import { findById } from "./find-by-id.ts";
import type { Handler } from "./handler.ts";
import { setPermissions } from "./set-permissions.ts";
import { update } from "./update.ts";

// Role management: every endpoint needs roles:manage.
export function route(h: Handler): Router {
  const r = Router();
  const manage = requirePermission(h.authzService, "roles", "manage");
  r.get("/", manage, find(h));
  r.get("/:id", manage, findById(h));
  r.post("/", manage, create(h));
  r.put("/:id", manage, update(h));
  r.put("/:id/permissions", manage, setPermissions(h));
  r.delete("/:id", manage, remove(h));
  return r;
}
