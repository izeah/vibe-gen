import type { RequestHandler } from "express";
import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { roleIdParams, roleSetPermissionsRequest } from "../../dto/role.ts";
import { ctxOf } from "../../middleware/context.ts";
import type { Handler } from "./handler.ts";

// PUT /v1/roles/:id/permissions (replaces the whole set)
export const setPermissions =
  (h: Handler): RequestHandler =>
  async (req, res) => {
    const { id } = parse(roleIdParams, req.params);
    const body = parse(roleSetPermissionsRequest, req.body);
    res.json(success(await h.roleService.setPermissions(ctxOf(res), id, body)));
  };
