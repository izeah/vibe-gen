import type { RequestHandler } from "express";
import { success } from "../../abstraction/response.ts";
import { parse } from "../../abstraction/validate.ts";
import { userIdParams, userUpdateRequest } from "../../dto/user.ts";
import { ctxOf } from "../../middleware/context.ts";
import type { Handler } from "./handler.ts";

// PUT /v1/users/:id (admin)
export const update =
  (h: Handler): RequestHandler =>
  async (req, res) => {
    const { id } = parse(userIdParams, req.params);
    const body = parse(userUpdateRequest, req.body);
    res.json(success(await h.userService.update(ctxOf(res), id, body)));
  };
