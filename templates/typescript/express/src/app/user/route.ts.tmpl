import { Router } from "express";
import { requirePermission } from "../../middleware/permission.ts";
import { create } from "./create.ts";
import { findById } from "./find-by-id.ts";
import type { Handler } from "./handler.ts";
import { me } from "./me.ts";
import { setRoles } from "./set-roles.ts";
import { update } from "./update.ts";

// Any authenticated user may read their own profile; managing other users needs a permission
// (users:*), which the seed grants to admin only. Changing a user's roles needs roles:manage:
// users:update alone must not let anyone grant themselves admin.
export function route(h: Handler): Router {
  const r = Router();
  const can = (action: string) => requirePermission(h.authzService, "users", action);
  r.get("/me", me(h));
  r.get("/:id", can("read"), findById(h));
  r.post("/", can("create"), create(h));
  r.put("/:id", can("update"), update(h));
  r.put("/:id/roles", requirePermission(h.authzService, "roles", "manage"), setRoles(h));
  return r;
}
